# Replace <NAS_LAN_IP> with the fixed LAN address that Windows clients use.
MUYING_V2_BIND_HOST=<NAS_LAN_IP>
MUYING_V2_PORT=8443
MUYING_V2_DATA_DIR=/var/lib/muying-v2
MUYING_V2_DB=/var/lib/muying-v2/muying-v2.db
MUYING_V2_PROVISIONER_SOCKET=/run/muying-v2/account.sock
MUYING_V2_PUBLIC_ROOT=/volume1/Assets
# Optional; enables read-only updater releases when set.
# Package ZIPs must be immutable/read-only on POSIX; publish new opaque IDs, never overwrite in place.
MUYING_V2_UPDATE_RELEASES_DIR=/volume1/muying-releases

# Optional; enables the unauthenticated first-install download when set. Left unset, the
# /download routes answer 503 rather than serving anything.
#
# Holds MuYingDrive.Setup-<X.Y.Z>.exe files. The highest version in the directory is what
# the stable URL serves, so publishing a new one needs no service restart. Read-only to
# the service: the download route only ever reads. Own it root:muying-v2, packages 0444.
MUYING_V2_INSTALLER_DIR=/volume1/muying-download

MUYING_V2_PROJECT_SOCKET=/run/muying-v2/project.sock
