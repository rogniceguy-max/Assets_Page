[Unit]
Description=MuYing Drive V2 account provisioner request

[Service]
Type=exec
WorkingDirectory=/opt/muying-v2/current
EnvironmentFile=/etc/muying-v2/helper.env
ExecStart=/usr/bin/python3 -m backend.account_helper
StandardInput=socket
StandardOutput=socket
StandardError=journal
UMask=0077
PrivateTmp=yes
ProtectHome=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6
TimeoutStartSec=90
