MUYING_V2_SERVICE_USER=muying-v2
MUYING_V2_PROVISIONER_LOCK=/run/lock/muying-v2-account-helper.lock
MUYING_V2_PUBLIC_ROOT=/volume1/Assets
MUYING_V2_USERNAME_MAP=/etc/samba/muying-v2-users.map
MUYING_V2_USERNAME_MANIFEST=/etc/samba/muying-v2-users.json

# 项目根与它的特权创建通道（project_helper 用）
MUYING_V2_PROJECT_DOCS_ROOT=/volume1/Assets/Project
