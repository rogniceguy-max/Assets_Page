[Unit]
Description=MuYing Drive V2 privileged account provisioner socket

[Socket]
ListenStream=/run/muying-v2/account.sock
Accept=yes
Service=muying-v2-account@.service
SocketUser=muying-v2
SocketGroup=muying-v2
SocketMode=0600
DirectoryMode=0755
RemoveOnStop=yes

[Install]
WantedBy=sockets.target
