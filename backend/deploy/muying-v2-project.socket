[Unit]
Description=MuYing Drive V2 privileged project provisioner socket

[Socket]
ListenStream=/run/muying-v2/project.sock
Accept=yes
Service=muying-v2-project@.service
# Owned by the service account and unreadable by anyone else, which is the first of two
# checks: the helper then verifies SO_PEERCRED on the accepted connection, so a process that
# somehow opened the socket still cannot use it.
SocketUser=muying-v2
SocketGroup=muying-v2
SocketMode=0600
DirectoryMode=0755
RemoveOnStop=yes

[Install]
WantedBy=sockets.target
