[Unit]
Description=MuYing Drive V2 project provisioner request

[Service]
Type=exec
WorkingDirectory=/opt/muying-v2/current
EnvironmentFile=/etc/muying-v2/helper.env
# The template generator needs openpyxl, which is installed as wheels outside the system
# interpreter (see deploy/install-pylib.sh). Set here rather than inherited, because this
# unit does not read server.env.
Environment=PYTHONPATH=/opt/muying-v2/pylib
ExecStart=/usr/bin/python3 -m backend.v2.project_helper
StandardInput=socket
StandardOutput=socket
StandardError=journal
UMask=0077
PrivateTmp=yes
ProtectHome=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6
# Deliberately no ProtectSystem and no ReadWritePaths: this unit exists precisely so that
# the *service* may keep ProtectSystem=strict. It runs as root, writes under
# MUYING_V2_PROJECT_DOCS_ROOT and nowhere else, and exits after one request.
TimeoutStartSec=90
