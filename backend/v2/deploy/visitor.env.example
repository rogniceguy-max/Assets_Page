# Environment for the root-side visitor read-only helper.
# Copy to /etc/muying-v2/visitor.env (root-owned, mode 0600) and adjust.

# The V2 service account allowed to talk to this socket (SO_PEERCRED check).
MUYING_V2_HELPER_PEER_USER=muying-v2

# The dedicated read-only identity the helper drops to before any filesystem access.
MUYING_V2_VISITOR_USER=沐影参观

# Optional. Space id -> absolute directory the visitor may read. Space roots are
# resolved here and never supplied by the client; unknown ids are rejected.
#MUYING_V2_VISITOR_SPACES={"film":"/volume1/Assets/01_影视资源库","writing":"/volume1/Assets/02_文学创作库","public":"/volume1/Assets/00_公共素材"}
