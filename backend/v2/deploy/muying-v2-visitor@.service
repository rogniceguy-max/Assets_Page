[Unit]
Description=MuYing Drive V2 visitor read-only request

[Service]
Type=exec
WorkingDirectory=/opt/muying-v2/current
EnvironmentFile=/etc/muying-v2/visitor.env
ExecStart=/usr/bin/python3 -m backend.v2.visitor_helper
StandardInput=socket
StandardOutput=socket
StandardError=journal
UMask=0077
PrivateTmp=yes
ProtectHome=yes
# The helper drops to the visitor identity before touching the filesystem and only
# ever talks over the inherited socket, so no other address family is needed.
RestrictAddressFamilies=AF_UNIX
TimeoutStartSec=60
