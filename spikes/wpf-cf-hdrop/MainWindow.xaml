<Window x:Class="AssetsPage.WpfCfHdropSpike.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WPF CF_HDROP Spike — Source"
        Width="720" Height="490" MinWidth="620" MinHeight="420"
        WindowStartupLocation="CenterScreen" Background="#F3F5F8">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="WPF file drag source" FontSize="25" FontWeight="SemiBold" Foreground="#17202A" />
        <TextBlock Grid.Row="1" Margin="0,8,0,18" TextWrapping="Wrap" Foreground="#52606D"
                   Text="Drag the synthetic file card into the separate receiver window. The source sends one absolute path using DataFormats.FileDrop with Copy-only semantics." />
        <Border Grid.Row="2" x:Name="DragCard" Background="White" BorderBrush="#8AA4C4" BorderThickness="2"
                CornerRadius="12" Padding="22" Cursor="Hand"
                PreviewMouseLeftButtonDown="DragCard_PreviewMouseLeftButtonDown"
                PreviewMouseLeftButtonUp="DragCard_PreviewMouseLeftButtonUp" MouseMove="DragCard_MouseMove">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="SYNTHETIC TEST FILE" FontSize="12" FontWeight="Bold" Foreground="#3167A3" />
                <TextBlock x:Name="FileNameText" Margin="0,8,0,4" FontSize="20" FontWeight="SemiBold" Foreground="#17202A" />
                <TextBlock x:Name="FilePathText" TextWrapping="Wrap" Foreground="#52606D" />
                <TextBlock Margin="0,18,0,0" Text="Hold the left mouse button and drag this card." Foreground="#687784" />
            </StackPanel>
        </Border>
        <DockPanel Grid.Row="3" Margin="0,18,0,0" LastChildFill="True">
            <Button DockPanel.Dock="Right" Padding="14,8" Margin="12,0,0,0" Content="Open separate receiver" Click="OpenReceiverButton_Click" />
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#52606D" />
        </DockPanel>
    </Grid>
</Window>
