<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.muying.mediaworker</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>__DEPLOYMENT_HOME__/media_worker/start.sh</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>EnvironmentVariables</key>
    <dict>
        <key>MUYING_V2_API_BASE_URI</key>
        <string></string>
        <key>MUYING_V2_MEDIA_WORKER_TOKEN</key>
        <string></string>
    </dict>
    <key>StandardOutPath</key>
    <string>__DEPLOYMENT_HOME__/Library/Logs/media_worker.log</string>
    <key>StandardErrorPath</key>
    <string>__DEPLOYMENT_HOME__/Library/Logs/media_worker_error.log</string>
</dict>
</plist>
