<Window x:Class="MuYingDrive.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="沐影盘 MuYing Drive"
        Width="1440" Height="920" MinWidth="1060" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="#0B1220"
        Loaded="MainWindow_Loaded"
        Closing="MainWindow_Closing">
    <Grid>
        <wv2:WebView2 x:Name="WebView" Visibility="Collapsed" />

        <Grid x:Name="StartupPanel" Background="#0B1220">
            <StackPanel Width="460" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Width="54" Height="54" CornerRadius="14" Background="#172554" HorizontalAlignment="Center">
                    <TextBlock Text="沐" FontSize="26" FontWeight="SemiBold" Foreground="#BFDBFE"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Margin="0,20,0,0" Text="正在启动沐影盘本地文件区"
                           FontSize="21" FontWeight="SemiBold" Foreground="White"
                           HorizontalAlignment="Center" />
                <ProgressBar x:Name="StartupProgress" Margin="0,20,0,0" Height="4" IsIndeterminate="True" />
                <TextBlock x:Name="StatusText" Margin="0,14,0,0" Text="正在启动本地服务…"
                           TextWrapping="Wrap" TextAlignment="Center" FontSize="13" Foreground="#94A3B8" />
                <Button x:Name="CloseButton" Margin="0,22,0,0" Padding="18,8"
                        Content="关闭" HorizontalAlignment="Center" Visibility="Collapsed"
                        Click="CloseButton_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
