<Project>

  <!--
    Single source of truth for the product version across every project under
    desktop/. The update protocol requires a strict three-component version
    (X.Y.Z): the client reports AssemblyVersion truncated to three parts, the
    updater parses ProductVersion, and the health marker is compared as a
    string. Duplicating <Version> per project let those drift.

    A command-line -p:Version=X.Y.Z still wins: global properties are set before
    this file is evaluated, so the Condition below is skipped.
  -->
  <PropertyGroup>
    <Version Condition="'$(Version)' == ''">1.0.0</Version>
    <AssemblyVersion>$(Version).0</AssemblyVersion>
    <FileVersion>$(Version).0</FileVersion>
    <!--
      The SDK otherwise appends "+<git source revision>" to InformationalVersion,
      which FileVersionInfo surfaces as ProductVersion. That suffix breaks the
      strict three-component parse; keep the informational version bare.
    -->
    <InformationalVersion>$(Version)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

</Project>
