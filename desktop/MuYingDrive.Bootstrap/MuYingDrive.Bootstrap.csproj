<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>MuYingDrive.Setup</AssemblyName>
    <RootNamespace>MuYingDrive.Bootstrap</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <!-- Self-contained so the setup executable needs no .NET runtime on a clean machine. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MuYingDrive.UpdateCore\MuYingDrive.UpdateCore.csproj" />
  </ItemGroup>

  <!--
    Only the ~300 byte NAS configuration is embedded. The client bundle is fetched from
    the NAS and verified against the signed release manifest at install time: embedding
    it produced a ~300 MB single-file executable that hung during host startup and could
    not be authenticated. Payload/ is gitignored; a build without it still succeeds but
    the setup executable reports that it has no baked-in configuration.
  -->
  <ItemGroup Condition="Exists('Payload\nas-client.json')">
    <EmbeddedResource Include="Payload\nas-client.json" LogicalName="MuYingDrive.Bootstrap.Payload.nas-client.json" />
  </ItemGroup>

</Project>
