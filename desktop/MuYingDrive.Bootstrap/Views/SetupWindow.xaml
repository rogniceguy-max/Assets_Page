<Window x:Class="MuYingDrive.Bootstrap.Views.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="沐影盘安装程序" Width="460" MinWidth="400" MaxWidth="520" Height="272" MinHeight="252"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" ShowInTaskbar="True"
        Background="{DynamicResource Brush.Surface.Canvas}" UseLayoutRounding="True" SnapsToDevicePixels="True"
        Closing="Window_Closing" AutomationProperties.Name="沐影盘安装程序">
    <!-- Block order follows the update window contract: separator, stage title,
         one explanation line, progress, status line, then the action area. -->
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="1" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{DynamicResource Brush.Border.Subtle}" />
        <Grid Grid.Row="1" Margin="24,22,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /><RowDefinition Height="10" /><RowDefinition Height="Auto" />
                <RowDefinition Height="20" /><RowDefinition Height="Auto" /><RowDefinition Height="10" />
                <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Polite" />
            <TextBlock Grid.Row="2" Text="{Binding Explanation}" Foreground="{DynamicResource Brush.Text.Secondary}"
                       TextWrapping="Wrap" />
            <!-- The download knows its own size, so the bar is determinate while it runs
                 and falls back to indeterminate for the stages that cannot measure
                 themselves (extraction, the version swap) rather than faking a percentage.
                 Both bindings are OneWay on purpose: ProgressBar.Value and .IsIndeterminate
                 are TwoWay by default and neither of these properties has a setter. -->
            <ProgressBar Grid.Row="4" Height="4" Minimum="0" Maximum="100"
                         Value="{Binding Progress, Mode=OneWay}"
                         IsIndeterminate="{Binding IsProgressIndeterminate, Mode=OneWay}"
                         AutomationProperties.Name="安装进度">
                <ProgressBar.Style>
                    <Style TargetType="ProgressBar">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ProgressBar.Style>
            </ProgressBar>
            <TextBlock Grid.Row="6" Text="{Binding Status}" Foreground="{DynamicResource Brush.Text.Secondary}" />
            <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="启动沐影盘" Margin="0,0,8,0" Command="{Binding LaunchCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasLaunchPath}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <!-- The only control available while the install is running. Without it a
                     stuck or unwanted install had no way out but Task Manager. -->
                <Button Content="取消" Margin="0,0,8,0" Command="{Binding CancelCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ActionButton}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="{Binding ActionText}" Command="{Binding CloseCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ActionButton}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBusy}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
