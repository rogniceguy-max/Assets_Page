<Window x:Class="MuYingDrive.ProjectWorkbooks.ReviewWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:MuYingDrive.ProjectWorkbooks"
 Title="{Binding Title}" Width="980" Height="760" MinWidth="460" MinHeight="520"
 WindowStartupLocation="CenterOwner" Closing="OnClosing"
 Background="{DynamicResource Brush.Surface.Canvas}"
 FontFamily="{DynamicResource Typography.FontFamily}" FontSize="13">
 <!-- HOST ADJUSTMENT. The markup that was here is ReviewPanel.xaml now, so the beat detail
      panel can host the same discussion without a second copy of it. This window is the
      asset row's 讨论 button, which has nowhere else to put it. -->
 <local:ReviewPanel x:Name="Panel" Margin="20"/>
</Window>
