<UserControl x:Class="MuYingDrive.ProjectWorkbooks.ProjectWorkbooksView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:MuYingDrive.ProjectWorkbooks"
 Loaded="OnLoaded" Background="{DynamicResource Brush.Surface.Canvas}"
 Foreground="{DynamicResource Brush.Text.Primary}" FontSize="14" FontFamily="{DynamicResource Typography.FontFamily}">
 <UserControl.Resources>
  <!-- Scoped fallback only. OnLoaded adopts matching host resources. Never merged into App.Resources. -->
  <SolidColorBrush x:Key="Brush.Surface.Canvas" Color="#101112"/>
  <SolidColorBrush x:Key="Brush.Surface.Panel" Color="#191A1C"/>
  <SolidColorBrush x:Key="Brush.Border.Subtle" Color="#303238"/>
  <SolidColorBrush x:Key="Brush.Text.Primary" Color="#F0F1F4"/>
  <SolidColorBrush x:Key="Brush.Text.Secondary" Color="#A8ADB7"/>
  <SolidColorBrush x:Key="Brush.Accent.Primary" Color="#6058D6"/>
  <SolidColorBrush x:Key="Brush.Status.Danger" Color="#D14343"/>
  <FontFamily x:Key="Typography.FontFamily">Inter, Noto Sans SC, Microsoft YaHei UI</FontFamily>
  <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
  <local:InverseBooleanToVisibilityConverter x:Key="InverseBoolVisibility"/>
  <Style x:Key="Typography.Caption" TargetType="TextBlock">
   <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}"/>
   <Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,0,0,6"/>
  </Style>
  <Style x:Key="Button.Secondary" TargetType="Button">
   <Setter Property="Background" Value="{DynamicResource Brush.Surface.Panel}"/>
   <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}"/>
   <Setter Property="Padding" Value="10,7"/><Setter Property="Margin" Value="0,0,6,6"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border><ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Brush.Accent.Primary}"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderThickness" Value="2"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.5"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Button.Primary" TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
   <Setter Property="Background" Value="{DynamicResource Brush.Accent.Primary}"/>
  </Style>
  <Style TargetType="Button" BasedOn="{StaticResource Button.Secondary}"/>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="Cell" TargetType="Border"><Setter Property="Padding" Value="10"/>
   <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}"/><Setter Property="BorderThickness" Value="0,0,1,0"/>
  </Style>
  <DataTemplate x:Key="SceneRowTemplate">
   <Border Loaded="OnRowLoaded" Focusable="True"
           BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1" Margin="0,0,0,8"
           Background="{DynamicResource Brush.Surface.Panel}">
    <Border.ContextMenu>
     <ContextMenu>
      <MenuItem Header="新增下一节拍行" Click="OnAddSceneRow"/>
      <MenuItem Header="打开侧边栏" Click="OnOpenSceneSidebar"/>
      <Separator/>
      <MenuItem Header="删除此节拍行" Click="OnDeleteSceneRow" Foreground="{DynamicResource Brush.Status.Danger}"
                IsEnabled="{Binding Row.CanEdit}"/>
     </ContextMenu>
    </Border.ContextMenu>
    <StackPanel>
     <!-- Top Bar: 一行三列平均分开 (场景号 | 节拍号 | 制作难度) -->
     <Grid Margin="12,10,12,10">
      <Grid.ColumnDefinitions>
       <ColumnDefinition Width="*"/>
       <ColumnDefinition Width="*"/>
       <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- 1. 场景号 (占 1/3) -->
      <Grid Grid.Column="0" Margin="0,0,16,0">
       <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
       </Grid.ColumnDefinitions>
       <TextBlock Text="场景号" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="12" Margin="0,0,8,0"/>
       <TextBox Grid.Column="1" Text="{Binding SceneNumberDraft, UpdateSourceTrigger=PropertyChanged}"
                LostFocus="OnSceneFieldLostFocus" KeyDown="OnSceneFieldKeyDown"
                HorizontalAlignment="Stretch"
                Background="{DynamicResource Brush.Surface.Canvas}"
                BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1"
                Padding="6,3" Foreground="{DynamicResource Brush.Text.Primary}"
                ToolTip="场景号（失焦或回车保存）" IsEnabled="{Binding Row.CanEdit}"/>
      </Grid>

      <!-- 2. 节拍号 (占 1/3) -->
      <Grid Grid.Column="1" Margin="8,0,8,0">
       <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
       </Grid.ColumnDefinitions>
       <TextBlock Text="节拍号" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="12" Margin="0,0,8,0"/>
       <TextBox Grid.Column="1" Text="{Binding BeatNumberDraft, UpdateSourceTrigger=PropertyChanged}"
                LostFocus="OnSceneFieldLostFocus" KeyDown="OnSceneFieldKeyDown"
                HorizontalAlignment="Stretch"
                Background="{DynamicResource Brush.Surface.Canvas}"
                BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1"
                Padding="6,3" Foreground="{DynamicResource Brush.Text.Primary}"
                ToolTip="节拍号（失焦或回车保存）" IsEnabled="{Binding Row.CanEdit}"/>
      </Grid>

      <!-- 3. 制作难度 (占 1/3) -->
      <Grid Grid.Column="2" Margin="16,0,0,0">
       <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
       </Grid.ColumnDefinitions>
       <TextBlock Text="制作难度" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="12" Margin="0,0,8,0"/>
       <ComboBox Grid.Column="1" ItemsSource="{Binding DataContext.LevelFilters, RelativeSource={RelativeSource AncestorType=UserControl}}"
                 SelectedItem="{Binding LabelLevelDraft}"
                 SelectionChanged="OnSceneLevelSelectionChanged"
                 HorizontalAlignment="Stretch" Padding="6,3"
                 IsEnabled="{Binding Row.CanEdit}"/>
      </Grid>
     </Grid>
     <Rectangle Height="1" Fill="{DynamicResource Brush.Border.Subtle}"/>

     <!-- Main Columns: 故事内容 | 拆分规划 | 批注 | 关联视频 (同一行不同列) -->
     <local:ResponsiveColumnsPanel Weights="4,1.4,1.6,160px" Breakpoint="760">
      <!-- 1. 故事内容 (主导行高) -->
      <Border Style="{StaticResource Cell}">
       <StackPanel>
        <TextBlock Text="故事内容" Style="{DynamicResource Typography.Caption}"/>
        <TextBox Text="{Binding StoryContentDraft, UpdateSourceTrigger=PropertyChanged}"
                 TextWrapping="Wrap" AcceptsReturn="True" MinHeight="44"
                 LostFocus="OnSceneFieldLostFocus" KeyDown="OnSceneFieldKeyDown"
                 Background="Transparent" BorderBrush="{DynamicResource Brush.Border.Subtle}"
                 BorderThickness="0,0,0,1" Padding="4,4"
                 Foreground="{DynamicResource Brush.Text.Primary}"
                 ToolTip="故事内容（回车换行，失焦自动保存）" IsEnabled="{Binding Row.CanEdit}"/>
       </StackPanel>
      </Border>
      <!-- 2. 拆分规划 (截断展示，点击弹侧栏) -->
      <Border Style="{StaticResource Cell}" Background="Transparent" Cursor="Hand"
              PreviewMouseLeftButtonUp="OnOpenSceneSidebar" ToolTip="点击打开侧边栏查看/编辑完整拆分规划">
       <StackPanel VerticalAlignment="Top">
        <TextBlock Text="拆分规划" Style="{DynamicResource Typography.Caption}"/>
        <TextBlock Text="{Binding BreakdownPlanDraft}"
                   TextTrimming="CharacterEllipsis" TextWrapping="Wrap" MaxHeight="46" Margin="0,5,0,0">
         <TextBlock.Style>
          <Style TargetType="TextBlock">
           <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
           <Style.Triggers>
            <DataTrigger Binding="{Binding HasBreakdownPlan}" Value="False">
             <Setter Property="Text" Value="点击添加规划..."/>
             <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}"/>
             <Setter Property="Opacity" Value="0.6"/>
            </DataTrigger>
           </Style.Triggers>
          </Style>
         </TextBlock.Style>
        </TextBlock>
       </StackPanel>
      </Border>
      <!-- 3. 批注 (显示最新批注，点击弹侧栏) -->
      <Border Style="{StaticResource Cell}" Background="Transparent" Cursor="Hand"
              PreviewMouseLeftButtonUp="OnOpenSceneSidebar" ToolTip="点击打开侧边栏查看/添加批注">
       <StackPanel VerticalAlignment="Top">
        <TextBlock Text="批注" Style="{DynamicResource Typography.Caption}"/>
        <StackPanel Visibility="{Binding HasReviews, Converter={StaticResource BoolVisibility}}" Margin="0,4,0,0">
         <TextBlock Text="{Binding ReviewCountText}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Primary}"/>
         <TextBlock Text="{Binding ReviewSnippetText}" FontSize="11" Foreground="{DynamicResource Brush.Text.Secondary}"
                    Margin="0,2,0,0" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" MaxHeight="36"/>
        </StackPanel>
        <StackPanel Visibility="{Binding HasReviews, Converter={StaticResource InverseBoolVisibility}}" Margin="0,4,0,0">
         <TextBlock Text="{Binding NoteDraft}" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" MaxHeight="36">
          <TextBlock.Style>
           <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
            <Style.Triggers>
             <DataTrigger Binding="{Binding HasNote}" Value="False">
              <Setter Property="Text" Value="点击添加批注..."/>
              <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}"/>
              <Setter Property="Opacity" Value="0.6"/>
             </DataTrigger>
            </Style.Triggers>
           </Style>
          </TextBlock.Style>
         </TextBlock>
        </StackPanel>
       </StackPanel>
      </Border>
      <!-- 4. 关联视频 (固定 160px，支持拖入与右键菜单) -->
      <Border Style="{StaticResource Cell}" AllowDrop="True" DragOver="OnVideoDragOver" Drop="OnVideoDrop">
       <StackPanel VerticalAlignment="Top">
        <TextBlock Text="关联视频" Style="{DynamicResource Typography.Caption}"/>
        <Grid Height="75" Margin="0,4,0,0" Background="{DynamicResource Brush.Surface.Canvas}">
         <!-- 空状态 -->
         <Border Visibility="{Binding HasVideo, Converter={StaticResource InverseBoolVisibility}}"
                 BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1"
                 Cursor="Hand" MouseLeftButtonUp="OnPickVideo" ToolTip="点击选择或拖入视频文件 (.mp4, .mov, .mkv)">
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
           <Path Data="M5 12h14 M12 5v14" Width="13" Height="13" Stretch="Uniform"
                 Stroke="{DynamicResource Brush.Text.Secondary}" StrokeThickness="2"
                 StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" Margin="0,0,0,3"/>
           <TextBlock Text="拖入/选择视频" FontSize="11" Foreground="{DynamicResource Brush.Text.Secondary}"/>
          </StackPanel>
         </Border>
         <!-- 已关联视频 -->
         <Grid Visibility="{Binding HasVideo, Converter={StaticResource BoolVisibility}}" ToolTip="{Binding Video.Name}">
          <Grid.ContextMenu>
           <ContextMenu>
            <MenuItem Header="更换视频" Click="OnPickVideo" IsEnabled="{Binding Row.CanEdit}"/>
            <MenuItem Header="设为成片" Click="OnSetFinalVideo" IsEnabled="{Binding Row.CanEdit}"/>
            <MenuItem Header="取消成片" Click="OnUnsetFinalVideo" IsEnabled="{Binding Row.CanEdit}"/>
            <Separator/>
            <MenuItem Header="移入废片" Click="OnDiscardVideo" IsEnabled="{Binding Row.CanEdit}"/>
            <MenuItem Header="{Binding DiscardedCount, StringFormat=查看废片库 ({0})}" Click="OnOpenDiscardedVideos"/>
            <Separator/>
            <MenuItem Header="删除此节拍行" Click="OnDeleteSceneRow" Foreground="{DynamicResource Brush.Status.Danger}" IsEnabled="{Binding Row.CanEdit}"/>
           </ContextMenu>
          </Grid.ContextMenu>
          <Border BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1" Padding="4">
           <StackPanel VerticalAlignment="Center">
            <WrapPanel HorizontalAlignment="Center" Margin="0,0,0,2">
             <Border Background="{DynamicResource Brush.Accent.Primary}" CornerRadius="3" Padding="3,1" Margin="0,0,3,0">
              <TextBlock Text="{Binding FinalBadgeText}" FontSize="10" Foreground="White" FontWeight="Bold"/>
             </Border>
             <TextBlock Text="🎬" FontSize="11" VerticalAlignment="Center"/>
            </WrapPanel>
            <TextBlock Text="{Binding VideoDisplayName}" FontSize="11" TextAlignment="Center"
                       TextTrimming="CharacterEllipsis" MaxHeight="30" Foreground="{DynamicResource Brush.Text.Primary}"/>
           </StackPanel>
          </Border>
          <!-- 悬浮显示 更换 -->
          <Border Background="#88000000" Cursor="Hand" MouseLeftButtonUp="OnPickVideo" ToolTip="点击更换视频">
           <Border.Style>
            <Style TargetType="Border">
             <Setter Property="Opacity" Value="0"/>
             <Style.Triggers>
              <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Grid}}" Value="True">
               <Setter Property="Opacity" Value="1"/>
              </DataTrigger>
             </Style.Triggers>
            </Style>
           </Border.Style>
           <Border Background="{DynamicResource Brush.Surface.Panel}" BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1"
                   CornerRadius="4" Padding="8,3" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="更换视频" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource Brush.Text.Primary}"/>
           </Border>
          </Border>
         </Grid>
        </Grid>
       </StackPanel>
      </Border>
     </local:ResponsiveColumnsPanel>
    </StackPanel>
   </Border>
  </DataTemplate>
  <DataTemplate x:Key="AssetRowTemplate">
   <Border Loaded="OnRowLoaded" BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1" Margin="0,0,0,8" Background="{DynamicResource Brush.Surface.Panel}">
    <Border.ContextMenu>
     <ContextMenu>
      <MenuItem Header="删除此资产行" Click="OnDeleteAssetRow" Foreground="{DynamicResource Brush.Status.Danger}"
                IsEnabled="{Binding Row.CanEdit}"/>
     </ContextMenu>
    </Border.ContextMenu>
    <local:ResponsiveColumnsPanel Weights="0.8,1.2,0.8,160px,2.2,2.4" Breakpoint="760">
     <Border Style="{StaticResource Cell}">
      <StackPanel>
       <TextBlock Text="类别" Style="{DynamicResource Typography.Caption}"/>
       <TextBox Text="{Binding CategoryDraft, UpdateSourceTrigger=PropertyChanged}"
                LostFocus="OnAssetFieldLostFocus" KeyDown="OnAssetFieldKeyDown"
                Background="Transparent" BorderBrush="{DynamicResource Brush.Border.Subtle}"
                BorderThickness="0,0,0,1" Padding="2,4"
                Foreground="{DynamicResource Brush.Text.Primary}"
                IsEnabled="{Binding Row.CanEdit}" ToolTip="资产类别（失焦或回车保存）"/>
      </StackPanel>
     </Border>
     <Border Style="{StaticResource Cell}">
      <StackPanel>
       <TextBlock Text="名称 / 形态" Style="{DynamicResource Typography.Caption}"/>
       <TextBox Text="{Binding NameDraft, UpdateSourceTrigger=PropertyChanged}"
                LostFocus="OnAssetFieldLostFocus" KeyDown="OnAssetFieldKeyDown"
                Background="Transparent" BorderBrush="{DynamicResource Brush.Border.Subtle}"
                BorderThickness="0,0,0,1" Padding="2,4"
                Foreground="{DynamicResource Brush.Text.Primary}"
                IsEnabled="{Binding Row.CanEdit}" ToolTip="资产名称（失焦或回车保存）"/>
       <TextBlock Text="{Binding Row.Variant}" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,4,0,0"/>
      </StackPanel>
     </Border>
     <Border Style="{StaticResource Cell}">
      <StackPanel>
       <TextBlock Text="出场" Style="{DynamicResource Typography.Caption}"/>
       <TextBlock Text="{Binding Row.Appearance}"/>
      </StackPanel>
     </Border>
     <Border Style="{StaticResource Cell}" AllowDrop="True" Tag="selected" DragOver="OnImageDragOver" Drop="OnImageDrop">
      <StackPanel>
       <TextBlock Text="选定" Style="{DynamicResource Typography.Caption}"/>
       <Grid Height="120" Background="{DynamicResource Brush.Surface.Canvas}">
        <Border Visibility="{Binding HasNoSelected, Converter={StaticResource BoolVisibility}}"
                BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1"
                Cursor="Hand" Tag="selected" MouseLeftButtonUp="OnPickSelectedCandidate" ToolTip="点击从本行备选选择或拖入图片">
         <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
          <Path Data="M5 12h14 M12 5v14" Width="14" Height="14" Stretch="Uniform"
                Stroke="{DynamicResource Brush.Text.Secondary}" StrokeThickness="2"
                StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" Margin="0,0,0,6"/>
          <TextBlock Text="点击选择图片" FontSize="11" Foreground="{DynamicResource Brush.Text.Secondary}"/>
         </StackPanel>
        </Border>
        <Grid Visibility="{Binding HasSelected, Converter={StaticResource BoolVisibility}}"
              ToolTip="{Binding Selected.Name}">
         <Grid.ContextMenu>
          <ContextMenu>
           <MenuItem Header="更换图片" Tag="selected" Click="OnPickSelectedCandidate" IsEnabled="{Binding Row.CanEdit}"/>
           <MenuItem Header="查看大图与评价" Click="OnPreviewSelected"/>
           <Separator/>
           <MenuItem Header="从选定清空" Click="OnClearSelected" IsEnabled="{Binding Row.CanEdit}"/>
           <Separator/>
           <MenuItem Header="删除此资产行" Click="OnDeleteAssetRow" Foreground="{DynamicResource Brush.Status.Danger}" IsEnabled="{Binding Row.CanEdit}"/>
          </ContextMenu>
         </Grid.ContextMenu>
         <Image Source="{Binding Selected.Preview}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
         <Border Background="#88000000" Cursor="Hand" Tag="selected" MouseLeftButtonUp="OnPickSelectedCandidate" ToolTip="点击更换图片">
          <Border.Style>
           <Style TargetType="Border">
            <Setter Property="Opacity" Value="0"/>
            <Style.Triggers>
             <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Grid}}" Value="True">
              <Setter Property="Opacity" Value="1"/>
             </DataTrigger>
            </Style.Triggers>
           </Style>
          </Border.Style>
          <Border Background="{DynamicResource Brush.Surface.Panel}" BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1"
                  CornerRadius="4" Padding="12,5" HorizontalAlignment="Center" VerticalAlignment="Center">
           <TextBlock Text="更换" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource Brush.Text.Primary}"/>
          </Border>
         </Border>
        </Grid>
       </Grid>
      </StackPanel>
     </Border>
     <Border Style="{StaticResource Cell}" AllowDrop="True" Tag="candidates" DragOver="OnImageDragOver" Drop="OnImageDrop">
      <StackPanel>
       <TextBlock Text="备选" Style="{DynamicResource Typography.Caption}" Margin="0,0,0,6"/>
       <Grid MinHeight="64">
        <Border Visibility="{Binding HasNoCandidates, Converter={StaticResource BoolVisibility}}"
                BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1"
                CornerRadius="4" Padding="8,14" Background="Transparent"
                Cursor="Hand" MouseLeftButtonUp="OnPickCandidateFiles" ToolTip="点击选择或拖入图片到此处作为备选">
         <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
          <TextBlock Text="拖入图片添加备选" FontSize="11" Foreground="{DynamicResource Brush.Text.Secondary}" Opacity="0.7"/>
         </StackPanel>
        </Border>
        <ItemsControl ItemsSource="{Binding Candidates}" Visibility="{Binding HasCandidates, Converter={StaticResource BoolVisibility}}">
        <ItemsControl.ItemsPanel>
         <ItemsPanelTemplate>
          <WrapPanel/>
         </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
         <DataTemplate>
          <Border Margin="0,0,6,6" Background="{DynamicResource Brush.Surface.Canvas}" BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1" CornerRadius="4" Padding="2" ToolTip="{Binding Name}">
           <Border.ContextMenu>
            <ContextMenu>
             <MenuItem Header="设为选定图片" Click="OnUseCandidate"/>
             <MenuItem Header="查看大图与评价" Click="OnPreviewCandidate"/>
             <Separator/>
             <MenuItem Header="从备选移除" Click="OnRemoveCandidate"/>
             <Separator/>
             <MenuItem Header="删除此资产行" Click="OnDeleteAssetRow" Foreground="{DynamicResource Brush.Status.Danger}" IsEnabled="{Binding DataContext.Row.CanEdit, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
            </ContextMenu>
           </Border.ContextMenu>
           <Grid Width="64" Height="64">
            <Button Click="OnPreviewCandidate" Padding="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ToolTip="点击查看大图或设为选定（右键菜单更多操作）">
             <Image Source="{Binding Preview}" Stretch="Uniform"/>
            </Button>
            <Button Content="✕" Click="OnRemoveCandidate" HorizontalAlignment="Right" VerticalAlignment="Top" Width="16" Height="16" Padding="0" FontSize="9"
                    Opacity="0.8" ToolTip="移除备选" IsEnabled="{Binding DataContext.Row.CanEdit, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
           </Grid>
          </Border>
         </DataTemplate>
        </ItemsControl.ItemTemplate>
        </ItemsControl>
       </Grid>
      </StackPanel>
     </Border>
     <Border Style="{StaticResource Cell}" Background="Transparent" Cursor="Hand"
             MouseLeftButtonUp="OnAssetReviewClick" ToolTip="点击打开资产评审侧栏">
      <StackPanel>
       <TextBlock Text="评审" Style="{DynamicResource Typography.Caption}"/>
       <StackPanel Visibility="{Binding HasReviews, Converter={StaticResource BoolVisibility}}" Margin="0,6,0,0">
        <TextBlock Text="{Binding ReviewCountText}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Primary}"/>
        <TextBlock Text="{Binding ReviewSnippetText}" FontSize="11" Foreground="{DynamicResource Brush.Text.Secondary}"
                   Margin="0,4,0,0" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" MaxHeight="36"/>
       </StackPanel>
      </StackPanel>
     </Border>
    </local:ResponsiveColumnsPanel>
   </Border>
  </DataTemplate>
 </UserControl.Resources>
 <Grid Margin="24,20,24,22">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <StackPanel Grid.Row="0">
   <ProgressBar Height="3" IsIndeterminate="True" Margin="0,0,0,8" Visibility="Collapsed"
                local:DelayedVisibility.IsBusy="{Binding Busy}"/>
   <TextBlock Text="{Binding Error}" Foreground="{DynamicResource Brush.Status.Danger}" Margin="0,0,0,8"
              Visibility="{Binding CanReload, Converter={StaticResource BoolVisibility}}"/>
   <Button Content="重新加载" Click="OnRefresh" HorizontalAlignment="Left" Margin="0,0,0,8" IsEnabled="{Binding Ready}"
           Visibility="{Binding CanReload, Converter={StaticResource BoolVisibility}}"/>
   <StackPanel Visibility="{Binding HasPendingOperation, Converter={StaticResource BoolVisibility}}" IsEnabled="{Binding Ready}" Margin="0,0,0,12">
    <TextBlock Text="{Binding PendingText}"/><WrapPanel Margin="0,6,0,0"><Button Content="重试这次操作" Click="OnRetryPending"/><Button Content="取消待确认操作" Click="OnCancelPending"/></WrapPanel>
   </StackPanel>
  </StackPanel>
  <Grid Grid.Row="1" IsEnabled="{Binding Ready}">
   <Grid Visibility="{Binding IsHome, Converter={StaticResource BoolVisibility}}" Background="Transparent">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <!-- The gap below the button row: without it the first file card sat right against the
         buttons, which reads as one cramped block rather than "actions, then what they act
         on". -->
    <StackPanel><WrapPanel Margin="0,0,0,14">
     <Button Content="新建节拍表" Tag="scene_beats" Click="OnCreate" Style="{DynamicResource Button.Primary}"/>
     <Button Content="新建资产表" Tag="asset_review" Click="OnCreate"/>
    </WrapPanel></StackPanel>
    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
     <ItemsControl ItemsSource="{Binding Files}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate><DataTemplate>
       <Border Width="200" Height="130" Margin="0,0,12,12"
               Background="{DynamicResource Brush.Surface.Panel}"
               BorderBrush="{DynamicResource Brush.Border.Subtle}"
               BorderThickness="1" CornerRadius="8" Padding="12"
               Cursor="Hand" MouseLeftButtonUp="OnCardClick"
               Focusable="True" KeyDown="OnCardKeyDown">
        <Border.ContextMenu>
         <ContextMenu>
          <MenuItem Header="打开工作簿" Click="OnOpenFile"/>
          <MenuItem Header="重命名 (F2)" Click="OnStartRenameFile"/>
          <Separator/>
          <MenuItem Header="删除工作簿" Click="OnDeleteWorkbookFromMenu" Foreground="{DynamicResource Brush.Status.Danger}"/>
         </ContextMenu>
        </Border.ContextMenu>
        <Grid>
         <Grid.RowDefinitions>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
         </Grid.RowDefinitions>
         <TextBlock Grid.Row="0" Text="▦" FontSize="36" Foreground="{DynamicResource Brush.Accent.Primary}"
                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
         <Grid Grid.Row="1" MinHeight="34">
          <TextBlock Text="{Binding Name}" TextWrapping="Wrap" MaxHeight="36" TextTrimming="CharacterEllipsis"
                     HorizontalAlignment="Center" TextAlignment="Center" FontWeight="Medium"
                     Visibility="{Binding IsEditingName, Converter={StaticResource InverseBoolVisibility}}"/>
          <TextBox Text="{Binding NameDraft, UpdateSourceTrigger=PropertyChanged}"
                   Visibility="{Binding IsEditingName, Converter={StaticResource BoolVisibility}}"
                   HorizontalContentAlignment="Center" Background="{DynamicResource Brush.Surface.Canvas}"
                   BorderBrush="{DynamicResource Brush.Accent.Primary}" BorderThickness="1.5" Padding="4,2"
                   LostFocus="OnCardRenameLostFocus" KeyDown="OnCardRenameKeyDown"/>
         </Grid>
        </Grid>
       </Border>
      </DataTemplate></ItemsControl.ItemTemplate>
     </ItemsControl>
    </ScrollViewer>
   </Grid>
   <Grid Visibility="{Binding IsOpen, Converter={StaticResource BoolVisibility}}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel>
     <WrapPanel Margin="0,0,0,12"><ComboBox ItemsSource="{Binding Sheets}" SelectedItem="{Binding SelectedSheet}" MinWidth="140" MaxWidth="280" Margin="0,0,12,0">
       <ComboBox.ItemTemplate>
        <DataTemplate>
         <TextBlock Text="{Binding Name}"/>
        </DataTemplate>
       </ComboBox.ItemTemplate>
      </ComboBox>
      <Button Content="+ 新增集数" Click="OnAddEpisode" Margin="0,0,12,0" Padding="8,4"
              Visibility="{Binding SelectedSheet.IsScene, Converter={StaticResource BoolVisibility}}"
              ToolTip="为当前节拍表新增一集"/>
      <Button Click="OnAddSceneRow" Margin="0,0,12,0" Padding="10,5"
              Visibility="{Binding SelectedSheet.IsScene, Converter={StaticResource BoolVisibility}}"
              ToolTip="为当前节拍表新增一行节拍">
       <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Path Data="M5 12h14 M12 5v14"
              Width="13" Height="13" Stretch="Uniform"
              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
              StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
              VerticalAlignment="Center" Margin="0,0,6,0"/>
        <TextBlock Text="新增节拍行" VerticalAlignment="Center"/>
       </StackPanel>
      </Button>
      <Button Click="OnAddAssetRow" Margin="0,0,12,0" Padding="10,5"
              Visibility="{Binding SelectedSheet.IsAsset, Converter={StaticResource BoolVisibility}}"
              ToolTip="为当前资产表新增一行资产">
       <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Path Data="M5 12h14 M12 5v14"
              Width="13" Height="13" Stretch="Uniform"
              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
              StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
              VerticalAlignment="Center" Margin="0,0,6,0"/>
        <TextBlock Text="新增资产列" VerticalAlignment="Center"/>
       </StackPanel>
      </Button>
      <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Width="200" Padding="6" ToolTip="搜索当前工作表（场景、节拍、正文、规划或资产）" Background="{DynamicResource Brush.Surface.Panel}" Foreground="{DynamicResource Brush.Text.Primary}"/>
      <ComboBox ItemsSource="{Binding LevelFilters}" SelectedItem="{Binding LevelFilter}" Width="150" Margin="12,0,0,0" ToolTip="制作难度筛选"
                Visibility="{Binding SelectedSheet.IsScene, Converter={StaticResource BoolVisibility}}">
       <ComboBox.ItemTemplate>
        <DataTemplate>
         <TextBlock x:Name="LevelFilterLabel" Text="{Binding}"/>
         <DataTemplate.Triggers>
          <DataTrigger Binding="{Binding}" Value="全部等级">
           <Setter TargetName="LevelFilterLabel" Property="Text" Value="制作难度"/>
          </DataTrigger>
         </DataTemplate.Triggers>
        </DataTemplate>
       </ComboBox.ItemTemplate>
      </ComboBox>
     </WrapPanel>
    </StackPanel>
    <ScrollViewer x:Name="WorkbookScroll" Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" ScrollChanged="OnWorkbookScroll">
     <StackPanel DataContext="{Binding SelectedSheet}">
      <ItemsControl ItemsSource="{Binding DataContext.VisibleAssets, RelativeSource={RelativeSource AncestorType=UserControl}}" ItemTemplate="{StaticResource AssetRowTemplate}" Visibility="{Binding IsAsset, Converter={StaticResource BoolVisibility}}"/>
      <ItemsControl ItemsSource="{Binding DataContext.VisibleScenes, RelativeSource={RelativeSource AncestorType=UserControl}}" ItemTemplate="{StaticResource SceneRowTemplate}" Visibility="{Binding IsScene, Converter={StaticResource BoolVisibility}}"/>
      <ItemsControl ItemsSource="{Binding GenericRows}" Visibility="{Binding IsGeneric, Converter={StaticResource BoolVisibility}}">
       <ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1" Padding="12" Margin="0,0,0,8">
        <ItemsControl ItemsSource="{Binding Cells}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,0,0,12"><TextBlock Text="{Binding Label}" Style="{DynamicResource Typography.Caption}"/><TextBlock Text="{Binding Value}"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
       </Border></DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl>
     </StackPanel>
    </ScrollViewer>
    <!-- Full Overlay Drawer for Scene and Asset details (does NOT squeeze or move the table) -->
    <Grid x:Name="ScenePanelHost" Grid.RowSpan="3" Visibility="Collapsed" Panel.ZIndex="100">
     <!-- Click outside backdrop to dismiss drawer -->
     <Border Background="#25000000" PreviewMouseLeftButtonDown="OnOverlayBackdropMouseDown" PreviewMouseLeftButtonUp="OnOverlayBackdropMouseUp"/>
     <!-- Floating Drawer Panel on the right -->
     <Border HorizontalAlignment="Right" Width="400"
             Background="{DynamicResource Brush.Surface.Panel}"
             BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1,0,0,0">
      <Border.Effect>
       <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.3"/>
      </Border.Effect>
      <ContentControl x:Name="ScenePanelContent"/>
     </Border>
    </Grid>
   </Grid>
  </Grid>
 </Grid>
</UserControl>
