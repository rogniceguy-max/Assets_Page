<UserControl x:Class="MuYingDrive.NativeWpf.Views.FeedbackView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:MuYingDrive.NativeWpf.Controls"
 Background="{DynamicResource Brush.Surface.Canvas}">
 <UserControl.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="FeedbackStyles.xaml"/></ResourceDictionary.MergedDictionaries>
   <BooleanToVisibilityConverter x:Key="Visible" />
  </ResourceDictionary>
 </UserControl.Resources>
 <Grid Margin="24,19,24,20">
  <Grid.RowDefinitions>
   <RowDefinition Height="36"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="*"/>
   <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>

  <Grid Grid.Row="0" Margin="0,0,12,0">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Grid>
    <Grid.Style>
     <Style TargetType="Grid">
      <Style.Triggers><DataTrigger Binding="{Binding IsDetail}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
     </Style>
    </Grid.Style>
    <TextBox Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" Style="{StaticResource TextBox.Base}"
             Padding="11,0" Height="36" VerticalContentAlignment="Center" AutomationProperties.Name="搜索问题或建议" ToolTip="搜索问题或建议">
     <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding SearchCommand}"/></TextBox.InputBindings>
    </TextBox>
    <TextBlock Text="搜索问题或建议……" IsHitTestVisible="False" Margin="12,0" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Text.Secondary}">
     <TextBlock.Style>
      <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
       <Setter Property="Visibility" Value="Collapsed"/>
       <Style.Triggers><DataTrigger Binding="{Binding Query}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
      </Style>
     </TextBlock.Style>
    </TextBlock>
   </Grid>
   <Button Grid.Column="1" Margin="16,0,0,0" Padding="11,0" Height="36" Style="{StaticResource Button.Primary}"
           Click="NewFeedback_Click" AutomationProperties.Name="新建反馈">
    <StackPanel Orientation="Horizontal">
     <controls:LucideIcon Icon="Plus" Width="16" Height="16" Stroke="{DynamicResource Brush.Text.OnAccent}"/>
     <TextBlock Text="新建反馈" Foreground="{DynamicResource Brush.Text.OnAccent}" Margin="8,0,0,0"/>
    </StackPanel>
   </Button>
  </Grid>

  <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,0">
   <StackPanel.Style>
    <Style TargetType="StackPanel">
     <Style.Triggers><DataTrigger Binding="{Binding IsDetail}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
    </Style>
   </StackPanel.Style>
   <Button Content="全部" Width="72" Height="32" Padding="0" Command="{Binding FilterCommand}" CommandParameter="all" Style="{StaticResource Button.Compact}" Margin="0,0,8,0"/>
   <Button Content="问题反馈" Width="88" Height="32" Padding="0" Command="{Binding FilterCommand}" CommandParameter="problem" Style="{StaticResource Button.Compact}" Margin="0,0,8,0"/>
   <Button Content="功能建议" Width="88" Height="32" Padding="0" Command="{Binding FilterCommand}" CommandParameter="suggestion" Style="{StaticResource Button.Compact}"/>
  </StackPanel>

  <StackPanel Grid.Row="2">
   <TextBlock Text="正在加载……" Foreground="{DynamicResource Brush.Text.Secondary}"
              Visibility="{Binding IsBusy, Converter={StaticResource Visible}}" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"/>
   <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text.Secondary}"
              Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite">
    <TextBlock.Style>
     <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Style.Triggers><DataTrigger Binding="{Binding Message}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
     </Style>
    </TextBlock.Style>
   </TextBlock>
   <StackPanel>
    <StackPanel.Style>
     <Style TargetType="StackPanel">
      <Setter Property="Visibility" Value="Collapsed"/>
      <Style.Triggers><DataTrigger Binding="{Binding CanManage}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
       <DataTrigger Binding="{Binding IsDetail}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
     </Style>
    </StackPanel.Style>
    <WrapPanel Margin="0,8,0,0">
     <Button Content="公开" Command="{Binding ScopeCommand}" CommandParameter="public" Style="{StaticResource Button.Compact}" Margin="0,0,8,0"/>
     <Button Content="待审核" Command="{Binding ScopeCommand}" CommandParameter="pending" Style="{StaticResource Button.Compact}" Margin="0,0,8,0"/>
     <Button Content="已隐藏" Command="{Binding ScopeCommand}" CommandParameter="hidden" Style="{StaticResource Button.Compact}"/>
    </WrapPanel>
    <TextBlock Text="{Binding FilterLabel}" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,8,0,0"/>
   </StackPanel>
  </StackPanel>

  <Grid Grid.Row="3">
   <Grid.Style>
    <Style TargetType="Grid">
     <Style.Triggers><DataTrigger Binding="{Binding IsDetail}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
    </Style>
   </Grid.Style>
   <ListBox ItemsSource="{Binding Items}" Style="{StaticResource ListBox.Base}" AutomationProperties.Name="公开匿名反馈列表">
    <ListBox.ItemTemplate><DataTemplate>
     <Button Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource Feedback.Row}">
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <StackPanel>
        <TextBlock Text="{Binding Title}" FontWeight="Medium" TextWrapping="Wrap"/>
        <TextBlock Text="{Binding Summary}" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="{StaticResource Typography.FontSize.Caption}" Margin="0,6,12,0"/>
       </StackPanel>
       <TextBlock Grid.Column="1" Text="{Binding StatusLabel}" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="12,0,0,0" VerticalAlignment="Center"/>
      </Grid>
     </Button>
    </DataTemplate></ListBox.ItemTemplate>
   </ListBox>
  </Grid>

  <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,12">
   <StackPanel.Style>
    <Style TargetType="StackPanel">
     <Style.Triggers><DataTrigger Binding="{Binding IsDetail}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
    </Style>
   </StackPanel.Style>
   <Button Content="上一页" Width="72" Height="32" Command="{Binding PageCommand}" CommandParameter="previous" Style="{StaticResource Button.Compact}"/>
   <TextBlock Text="{Binding PageLabel}" VerticalAlignment="Center" Margin="12,0,15,0"/>
   <Button Content="下一页" Width="72" Height="32" Command="{Binding PageCommand}" CommandParameter="next" Style="{StaticResource Button.Compact}"/>
  </StackPanel>

  <ScrollViewer Grid.Row="2" Grid.RowSpan="3" VerticalScrollBarVisibility="Auto" Visibility="{Binding IsDetail, Converter={StaticResource Visible}}">
   <StackPanel>
    <Button Content="返回列表" Command="{Binding BackCommand}" HorizontalAlignment="Left" Style="{StaticResource Button.Ghost}" Margin="0,0,0,12"/>
    <TextBlock Text="{Binding Detail.Title}" TextWrapping="Wrap" FontSize="{StaticResource Typography.FontSize.PageTitle}" FontWeight="SemiBold"/>
    <TextBlock Text="{Binding Detail.Summary}" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,8,0,0"/>
    <TextBlock Text="{Binding Detail.StatusLabel}" Foreground="{DynamicResource Brush.Accent.Primary}" Margin="0,8,0,16"/>
    <TextBlock Text="{Binding Detail.Description}" TextWrapping="Wrap" Margin="0,0,0,16"/>
    <ItemsControl ItemsSource="{Binding DetailImages}"><ItemsControl.ItemTemplate><DataTemplate>
     <Image Source="{Binding Image}" Stretch="Uniform" MaxHeight="420" Margin="0,0,0,12" AutomationProperties.Name="反馈截图"/>
    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    <StackPanel Visibility="{Binding CanManage, Converter={StaticResource Visible}}" Margin="0,12,0,0">
     <TextBlock Text="处理状态" Margin="0,0,0,8"/>
     <WrapPanel>
      <ComboBox Width="160" ItemsSource="{Binding StatusChoices}" SelectedValue="{Binding SelectedStatus}" SelectedValuePath="Value" DisplayMemberPath="Label" AutomationProperties.Name="处理状态" Margin="0,0,8,8"/>
      <ComboBox Width="160" ItemsSource="{Binding VisibilityChoices}" SelectedValue="{Binding SelectedVisibility}" SelectedValuePath="Value" DisplayMemberPath="Label" AutomationProperties.Name="公开范围" Margin="0,0,8,8"/>
      <Button Content="保存处理结果" Command="{Binding SaveStatusCommand}" Margin="0,0,0,8"/>
     </WrapPanel>
     <TextBlock Text="公开截图前，请逐张检查姓名、聊天、客户信息与内部地址。" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text.Secondary}"/>
    </StackPanel>
   </StackPanel>
  </ScrollViewer>

  <Grid Grid.RowSpan="5" IsHitTestVisible="False">
   <Grid.Style>
    <Style TargetType="Grid">
     <Setter Property="Visibility" Value="Collapsed"/>
     <Style.Triggers>
      <MultiDataTrigger>
       <MultiDataTrigger.Conditions>
        <Condition Binding="{Binding IsEmpty}" Value="True"/>
        <Condition Binding="{Binding IsDetail}" Value="False"/>
       </MultiDataTrigger.Conditions>
       <Setter Property="Visibility" Value="Visible"/>
      </MultiDataTrigger>
     </Style.Triggers>
    </Style>
   </Grid.Style>
   <TextBlock Text="暂无符合条件的反馈。可以提交一个问题或功能建议。" TextWrapping="Wrap"
              HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
              Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,4,0,0"/>
  </Grid>
 </Grid>
</UserControl>
