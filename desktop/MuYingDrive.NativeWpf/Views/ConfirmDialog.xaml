<Window x:Class="MuYingDrive.NativeWpf.Views.ConfirmDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="确认" Width="460" SizeToContent="Height" MinHeight="180" MaxHeight="560"
 WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
 Background="{DynamicResource Brush.Surface.Canvas}"
 Foreground="{DynamicResource Brush.Text.Primary}" FontFamily="{StaticResource Typography.FontFamily}"
 PreviewKeyDown="OnKeyDown" AutomationProperties.Name="确认操作">
 <!--
   The first confirmation dialog in this client: everything else is an informational box
   with a single 知道了 button. It exists because deleting material cannot be undone and a
   notice that only says "done" is not a question.

   The confirm button carries Button.Primary rather than a new danger style. Brush.Status.Danger
   is a text token; a solid danger fill would mean adding a token to both theme dictionaries,
   and the warning is already carried by the heading's colour and by the list of what is
   about to go.
 -->
 <Grid Margin="24">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <TextBlock x:Name="HeadingText" FontSize="{StaticResource Typography.FontSize.PageTitle}"
             FontWeight="SemiBold" Foreground="{DynamicResource Brush.Status.Danger}"
             TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive"/>
  <TextBlock x:Name="BodyText" Grid.Row="1" Margin="0,12,0,12" TextWrapping="Wrap"
             Foreground="{DynamicResource Brush.Text.Secondary}"/>
  <Border Grid.Row="2" BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1"
          CornerRadius="{StaticResource CornerRadius.Control}" Background="{DynamicResource Brush.Surface.Panel}">
   <ListBox x:Name="ItemList" Background="Transparent" BorderThickness="0" MaxHeight="240"
            ScrollViewer.VerticalScrollBarVisibility="Auto" Padding="4"
            AutomationProperties.Name="将受影响的项目"/>
  </Border>
  <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
   <!-- Cancel is deliberately the default button: Enter must not delete anything. -->
   <Button x:Name="CancelButton" Content="取消" Click="Cancel_Click" IsDefault="True" Margin="0,0,8,0"/>
   <Button x:Name="ConfirmButton" Click="Confirm_Click" Style="{StaticResource Button.Primary}"/>
  </StackPanel>
 </Grid>
</Window>
