<UserControl x:Class="MuYingDrive.NativeWpf.Views.TransferView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MuYingDrive.NativeWpf.Controls"
             Background="{DynamicResource Brush.Surface.Canvas}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style TargetType="ScrollBar" BasedOn="{StaticResource ScrollBar.FileArea}" />
        <DataTemplate x:Key="TransferTaskTemplate">
            <Border Padding="16" Margin="0,0,0,10" CornerRadius="{StaticResource CornerRadius.Card}"
                    Background="{DynamicResource Brush.Surface.Panel}" BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource Brush.Surface.Subtle}" Margin="0,0,12,0">
                            <controls:LucideIcon Icon="{Binding IconName}" Width="16" Height="16" Stroke="{DynamicResource Brush.Text.Secondary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding FileName}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding TransferSummary}" Foreground="{DynamicResource Brush.Text.Secondary}"
                                       FontSize="{StaticResource Typography.FontSize.Caption}" Margin="0,4,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding StateLabel}" Foreground="{DynamicResource Brush.Text.Secondary}" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Style.Triggers><DataTrigger Binding="{Binding State}" Value="Failed"><Setter Property="Foreground" Value="{DynamicResource Brush.Status.Danger}" /></DataTrigger></Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Button Width="32" MinWidth="32" Padding="0" ToolTip="暂停"
                                Command="{Binding DataContext.PauseCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Button.Compact}">
                                    <Setter Property="Width" Value="32" /><Setter Property="MinWidth" Value="32" /><Setter Property="Padding" Value="0" />
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers><DataTrigger Binding="{Binding CanPause}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                </Style>
                            </Button.Style>
                            <controls:LucideIcon Icon="Pause" Width="14" Height="14" Stroke="{DynamicResource Brush.Text.Secondary}" />
                        </Button>
                        <Button Width="32" MinWidth="32" Padding="0" ToolTip="继续"
                                Command="{Binding DataContext.ResumeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Button.Compact}">
                                    <Setter Property="Width" Value="32" /><Setter Property="MinWidth" Value="32" /><Setter Property="Padding" Value="0" />
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers><DataTrigger Binding="{Binding CanResume}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                </Style>
                            </Button.Style>
                            <controls:LucideIcon Icon="Play" Width="14" Height="14" Stroke="{DynamicResource Brush.Text.Secondary}" />
                        </Button>
                        <Button Width="32" MinWidth="32" Padding="0" ToolTip="重试"
                                Command="{Binding DataContext.RetryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Button.Compact}">
                                    <Setter Property="Width" Value="32" /><Setter Property="MinWidth" Value="32" /><Setter Property="Padding" Value="0" />
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers><DataTrigger Binding="{Binding CanRetry}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                </Style>
                            </Button.Style>
                            <controls:LucideIcon Icon="RefreshCw" Width="14" Height="14" Stroke="{DynamicResource Brush.Text.Secondary}" />
                        </Button>
                        <Button Width="32" MinWidth="32" Padding="0" ToolTip="取消"
                                Command="{Binding DataContext.CancelCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Button.Compact}">
                                    <Setter Property="Width" Value="32" /><Setter Property="MinWidth" Value="32" /><Setter Property="Padding" Value="0" />
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers><DataTrigger Binding="{Binding CanCancel}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                </Style>
                            </Button.Style>
                            <controls:LucideIcon Icon="X" Width="14" Height="14" Stroke="{DynamicResource Brush.Text.Secondary}" />
                        </Button>
                    </StackPanel>

                    <ProgressBar Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Minimum="0" Maximum="100" Value="{Binding Progress, Mode=OneWay}" Margin="42,14,0,0" VerticalAlignment="Center" Height="4" />
                    <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="42,8,0,0">
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource Brush.Status.Danger}"
                                   FontSize="{StaticResource Typography.FontSize.Caption}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding CommitOutcomeNotice}" Foreground="{DynamicResource Brush.Text.Secondary}"
                                   FontSize="{StaticResource Typography.FontSize.Caption}" TextWrapping="Wrap"
                                   Visibility="{Binding CommitOutcomeUnknown, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="24,20,24,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Padding="12,10" Margin="0,0,0,12"
                CornerRadius="{StaticResource CornerRadius.Control}"
                Background="{DynamicResource Brush.Surface.Panel}"
                BorderBrush="{DynamicResource Brush.Status.Danger}" BorderThickness="1"
                Visibility="{Binding HasOperationError, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding OperationErrorMessage}" Foreground="{DynamicResource Brush.Status.Danger}"
                       TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
        </Border>
        <Grid Grid.Row="1">
            <ListBox ItemsSource="{Binding Tasks}" ItemTemplate="{StaticResource TransferTaskTemplate}"
                     BorderThickness="0" Background="Transparent"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.CanContentScroll="True"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="VerticalContentAlignment" Value="Stretch" />
                        <Setter Property="Focusable" Value="False" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
            <Border Background="{DynamicResource Brush.Surface.Canvas}" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="暂无传输任务" Foreground="{DynamicResource Brush.Text.Secondary}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
        </Grid>
    </Grid>
</UserControl>

