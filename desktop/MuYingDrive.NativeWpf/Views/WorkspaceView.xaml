<UserControl x:Class="MuYingDrive.NativeWpf.Views.WorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MuYingDrive.NativeWpf.Controls"
             xmlns:vm="clr-namespace:MuYingDrive.NativeWpf.ViewModels"
             xmlns:views="clr-namespace:MuYingDrive.NativeWpf.Views"
             Background="{DynamicResource Brush.Surface.Canvas}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <DataTemplate DataType="{x:Type vm:FeedbackViewModel}"><views:FeedbackView /></DataTemplate>
        <!-- The employee workspace and the tour share this shell; the sidebar is driven
             by data so the tour simply has fewer entries rather than a separate view. -->
        <Style x:Key="NavItem" TargetType="Button" BasedOn="{StaticResource Button.Nav}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSidebarExpanded}" Value="False">
                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                    <Setter Property="Padding" Value="0" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Selection.Background}" />
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="NavItemTemplate">
            <Button Style="{StaticResource NavItem}"
                    Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding Key}" ToolTip="{Binding Label}"
                    AutomationProperties.Name="{Binding Label}">
                <StackPanel Orientation="Horizontal">
                    <controls:LucideIcon Icon="{Binding Icon}" Width="18" Height="18" Stroke="{DynamicResource Brush.Text.Secondary}" />
                    <TextBlock Text="{Binding Label}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Margin" Value="12,0,0,0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Button>
        </DataTemplate>
        <DataTemplate x:Key="SpaceItemTemplate">
            <Button Style="{StaticResource NavItem}"
                    Command="{Binding DataContext.SelectSpaceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding Key}" ToolTip="{Binding Label}"
                    AutomationProperties.Name="{Binding Label}">
                <StackPanel Orientation="Horizontal">
                    <controls:LucideIcon Icon="{Binding Icon}" Width="18" Height="18" Stroke="{DynamicResource Brush.Text.Secondary}" />
                    <TextBlock Text="{Binding Label}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Margin" Value="12,0,0,0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Button>
        </DataTemplate>
        <!-- A project-tree row. Same look as a navigation entry, but the collapsed-sidebar
             trigger reads the workspace rather than the row's own data, because a row is a
             ProjectNode and knows nothing about the sidebar. -->
        <Style x:Key="ProjectNodeRow" TargetType="Button" BasedOn="{StaticResource Button.Nav}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False">
                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                    <Setter Property="Padding" Value="0" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Selection.Background}" />
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <HierarchicalDataTemplate x:Key="ProjectNodeTemplate" ItemsSource="{Binding Children}">
            <Button Style="{StaticResource ProjectNodeRow}"
                    Command="{Binding DataContext.ActivateProjectNodeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding}" ToolTip="{Binding Name}"
                    AutomationProperties.Name="{Binding Name}">
                <!-- A Grid with a star column, not a horizontal StackPanel: a StackPanel
                     offers its children infinite width, so TextTrimming never has anything to
                     trim against and a long workbook name stretches the sidebar instead. -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <controls:LucideIcon Grid.Column="0" Icon="{Binding Icon}" Width="16" Height="16"
                                         VerticalAlignment="Center" Stroke="{DynamicResource Brush.Text.Secondary}" />
                    <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" Margin="10,0,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Button>
        </HierarchicalDataTemplate>
        <ContextMenu x:Key="AccountMenu">
            <MenuItem Header="{Binding PlacementTarget.DataContext.ExitLabel, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      Command="{Binding PlacementTarget.DataContext.ExitCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
        </ContextMenu>
    </UserControl.Resources>

    <Grid Background="{DynamicResource Brush.Surface.Canvas}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{DynamicResource Brush.Surface.Panel}"
                BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="0,0,1,0">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Width" Value="236" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSidebarExpanded}" Value="False">
                            <Setter Property="Width" Value="64" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid Margin="8,18,8,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="24" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <ItemsControl Grid.Row="0" ItemsSource="{Binding NavigationItems}" ItemTemplate="{StaticResource NavItemTemplate}" />

                <Border Grid.Row="2" Height="1" Background="{DynamicResource Brush.Border.Subtle}" Margin="4,0" />

                <!-- 项目: the group heading and its + on one row, so the button belongs to
                     the group it acts on rather than floating above a list of them. -->
                <Grid Grid.Row="3" Margin="10,0,4,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="项目" VerticalAlignment="Center"
                               FontSize="{StaticResource Typography.FontSize.Caption}"
                               Foreground="{DynamicResource Brush.Text.Secondary}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSidebarExpanded}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Button Grid.Column="1" Style="{StaticResource Button.Ghost}" Width="24" Height="24" Padding="0"
                            Command="{Binding CreateProjectCommand}" ToolTip="{Binding CreateProjectToolTip}"
                            AutomationProperties.Name="新建项目">
                        <controls:LucideIcon Icon="Plus" Width="15" Height="15" Stroke="{DynamicResource Brush.Text.Secondary}" />
                    </Button>
                </Grid>

                <!-- Why the group is empty, when it is. "No projects yet" and "the list did
                     not load" are the same blank space otherwise, and they need different
                     things from whoever is looking at it. -->
                <TextBlock Grid.Row="4" Text="{Binding ProjectListNotice}" TextWrapping="Wrap"
                           Margin="10,2,10,0" VerticalAlignment="Top"
                           FontSize="{StaticResource Typography.FontSize.Caption}"
                           Foreground="{DynamicResource Brush.Text.Secondary}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ProjectListNotice}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsSidebarExpanded}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <!-- Horizontal scrolling off, so a long name is trimmed rather than
                         widening the sidebar. The scrollbar style is applied here because the
                         TreeView builds its own ScrollViewer and does not inherit one from the
                         ListBox styles — without it the sidebar showed the default Windows
                         scrollbar, which looks nothing like the rest of the app. -->
                    <TreeView ItemsSource="{Binding Projects}" ItemTemplate="{StaticResource ProjectNodeTemplate}"
                              Background="Transparent" BorderThickness="0" Padding="0"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <TreeView.Resources>
                            <Style TargetType="ScrollBar" BasedOn="{StaticResource ScrollBar.FileArea}" />
                        </TreeView.Resources>
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                            </Style>
                        </TreeView.ItemContainerStyle>
                    </TreeView>
                </ScrollViewer>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="1" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="16,0,20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Style="{StaticResource Button.Ghost}" Width="36" MinWidth="36" Height="36" Padding="0"
                        Command="{Binding ToggleSidebarCommand}" ToolTip="折叠或展开导航" AutomationProperties.Name="折叠或展开导航">
                    <controls:LucideIcon Icon="PanelLeft" Width="18" Height="18" Stroke="{DynamicResource Brush.Text.Secondary}" />
                </Button>
                <TextBlock Grid.Column="1" Text="{Binding PageTitle}" FontSize="{StaticResource Typography.FontSize.SmallTitle}"
                           FontWeight="Medium" VerticalAlignment="Center" Margin="12,0,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentContent.IsHome}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding CurrentContent.IsOpen}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Grid.Column="1" Text="工作簿" FontSize="{StaticResource Typography.FontSize.SmallTitle}"
                           FontWeight="Medium" VerticalAlignment="Center" Margin="12,0,0,0"
                           Visibility="{Binding CurrentContent.IsHome, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <TextBlock Grid.Column="1" Text="{Binding CurrentContent.Document.File.Name}"
                           FontSize="{StaticResource Typography.FontSize.SmallTitle}" FontWeight="Medium"
                           VerticalAlignment="Center" Margin="12,0,0,0" TextTrimming="CharacterEllipsis"
                           Visibility="{Binding CurrentContent.IsOpen, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <ComboBox Grid.Column="2" Width="112" Height="32" MinHeight="32" Margin="0,0,14,0"
                          ItemsSource="{Binding ThemeChoices}" SelectedItem="{Binding CurrentTheme, UpdateSourceTrigger=PropertyChanged}"
                          AutomationProperties.Name="主题" />
                <!-- The tour has no update entry; the button is absent rather than disabled. -->
                <Button Grid.Column="3" Style="{StaticResource Button.Ghost}" Width="36" MinWidth="36" Height="36"
                        Padding="0" Margin="0,0,8,0" Command="{Binding InstallUpdateNowCommand}"
                        ToolTip="{Binding UpdateButtonToolTip}" AutomationProperties.Name="{Binding UpdateButtonName}"
                        Visibility="{Binding ShowUpdateEntry, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid Width="36" Height="36">
                        <controls:LucideIcon Icon="RefreshCw" Width="18" Height="18"
                                              Stroke="{DynamicResource Brush.Text.Secondary}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Ellipse Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Top"
                                 Margin="0,4,4,0" Fill="#E5484D" Stroke="{DynamicResource Brush.Surface.Panel}"
                                 StrokeThickness="1" Visibility="{Binding IsUpdateReady, Converter={StaticResource BooleanToVisibilityConverter}}"
                                 AutomationProperties.Name="有可用更新" />
                    </Grid>
                </Button>
                <Button x:Name="AccountButton" Grid.Column="4" Style="{StaticResource Button.Ghost}" Height="36" MinWidth="0"
                        Padding="8,0" Margin="0,0,0,0" ContextMenu="{StaticResource AccountMenu}"
                        Click="AccountButton_Click" ToolTip="账户菜单" AutomationProperties.Name="账户菜单">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <controls:LucideIcon Icon="UserRound" Width="16" Height="16" Stroke="{DynamicResource Brush.Text.Secondary}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding AccountLabel}" Foreground="{DynamicResource Brush.Text.Secondary}"
                                   Margin="8,0,6,0" VerticalAlignment="Center" MaxWidth="140" TextTrimming="CharacterEllipsis" />
                        <controls:LucideIcon Icon="ChevronRight" Width="14" Height="14" Stroke="{DynamicResource Brush.Text.Secondary}"
                                             VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                            <controls:LucideIcon.RenderTransform><RotateTransform Angle="90" /></controls:LucideIcon.RenderTransform>
                        </controls:LucideIcon>
                    </StackPanel>
                </Button>
            </Grid>
            <Border Grid.Row="1" Background="{DynamicResource Brush.Border.Subtle}" />
            <ContentControl Grid.Row="2" Content="{Binding CurrentContent}" />
        </Grid>
    </Grid>
</UserControl>
