<UserControl x:Class="MuYingDrive.NativeWpf.Views.WorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MuYingDrive.NativeWpf.Controls"
             Background="{DynamicResource Brush.Surface.Canvas}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="NavItem" TargetType="Button" BasedOn="{StaticResource Button.Nav}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSidebarExpanded}" Value="False">
                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                    <Setter Property="Padding" Value="0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="NavLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="12,0,0,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSidebarExpanded}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="NavSectionLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="10,0,0,10" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSidebarExpanded}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="NavCurrentFile" TargetType="Button" BasedOn="{StaticResource NavItem}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedNavigation}" Value="文件">
                    <Setter Property="Background" Value="{DynamicResource Brush.Selection.Background}" />
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="NavCurrentTransfer" TargetType="Button" BasedOn="{StaticResource NavItem}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedNavigation}" Value="传输">
                    <Setter Property="Background" Value="{DynamicResource Brush.Selection.Background}" />
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="NavSpaceOwn" TargetType="Button" BasedOn="{StaticResource NavItem}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedSpace}" Value="本部门"><Setter Property="Background" Value="{DynamicResource Brush.Selection.Background}" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="NavSpacePublic" TargetType="Button" BasedOn="{StaticResource NavItem}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedSpace}" Value="公共素材"><Setter Property="Background" Value="{DynamicResource Brush.Selection.Background}" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="NavSpacePersonal" TargetType="Button" BasedOn="{StaticResource NavItem}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedSpace}" Value="个人空间"><Setter Property="Background" Value="{DynamicResource Brush.Selection.Background}" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="NavSpaceOther" TargetType="Button" BasedOn="{StaticResource NavItem}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedSpace}" Value="其他部门"><Setter Property="Background" Value="{DynamicResource Brush.Selection.Background}" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <ContextMenu x:Key="AccountMenu">
            <MenuItem Header="退出登录"
                      Command="{Binding PlacementTarget.DataContext.SignOutCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
        </ContextMenu>
    </UserControl.Resources>

    <Grid Background="{DynamicResource Brush.Surface.Canvas}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{DynamicResource Brush.Surface.Panel}"
                BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="0,0,1,0">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Width" Value="236" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSidebarExpanded}" Value="False">
                            <Setter Property="Width" Value="64" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid Margin="8,18,8,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="24" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Button Grid.Row="0" Style="{StaticResource NavCurrentFile}" Command="{Binding NavigateCommand}" CommandParameter="文件" ToolTip="文件">
                    <StackPanel Orientation="Horizontal"><controls:LucideIcon Icon="Files" Width="18" Height="18" Stroke="{DynamicResource Brush.Text.Secondary}" /><TextBlock Text="文件" Style="{StaticResource NavLabel}" /></StackPanel>
                </Button>
                <Button Grid.Row="2" Style="{StaticResource NavCurrentTransfer}" Command="{Binding NavigateCommand}" CommandParameter="传输" ToolTip="传输">
                    <StackPanel Orientation="Horizontal"><controls:LucideIcon Icon="Upload" Width="18" Height="18" Stroke="{DynamicResource Brush.Text.Secondary}" /><TextBlock Text="传输" Style="{StaticResource NavLabel}" /></StackPanel>
                </Button>
                <Border Grid.Row="4" Height="1" Background="{DynamicResource Brush.Border.Subtle}" Margin="4,0" />
                <TextBlock Grid.Row="5" Text="空间" FontSize="{StaticResource Typography.FontSize.Caption}"
                           Foreground="{DynamicResource Brush.Text.Secondary}" Style="{StaticResource NavSectionLabel}" />
                <Button Grid.Row="6" Style="{StaticResource NavSpaceOwn}" Command="{Binding SelectSpaceCommand}" CommandParameter="本部门" ToolTip="本部门">
                    <StackPanel Orientation="Horizontal"><controls:LucideIcon Icon="FolderOpen" Width="18" Height="18" Stroke="{DynamicResource Brush.Text.Secondary}" /><TextBlock Text="本部门" Style="{StaticResource NavLabel}" /></StackPanel>
                </Button>
                <Button Grid.Row="7" Style="{StaticResource NavSpacePublic}" Command="{Binding SelectSpaceCommand}" CommandParameter="公共素材" ToolTip="公共素材">
                    <StackPanel Orientation="Horizontal"><controls:LucideIcon Icon="Image" Width="18" Height="18" Stroke="{DynamicResource Brush.Text.Secondary}" /><TextBlock Text="公共素材" Style="{StaticResource NavLabel}" /></StackPanel>
                </Button>
                <Button Grid.Row="8" Style="{StaticResource NavSpacePersonal}" Command="{Binding SelectSpaceCommand}" CommandParameter="个人空间" ToolTip="个人空间">
                    <StackPanel Orientation="Horizontal"><controls:LucideIcon Icon="UserRound" Width="18" Height="18" Stroke="{DynamicResource Brush.Text.Secondary}" /><TextBlock Text="个人空间" Style="{StaticResource NavLabel}" /></StackPanel>
                </Button>
                <Button Grid.Row="9" Style="{StaticResource NavSpaceOther}" Command="{Binding SelectSpaceCommand}" CommandParameter="其他部门" ToolTip="其他部门" VerticalAlignment="Top" Margin="0,0,0,0">
                    <StackPanel Orientation="Horizontal"><controls:LucideIcon Icon="Folder" Width="18" Height="18" Stroke="{DynamicResource Brush.Text.Secondary}" /><TextBlock Text="其他部门" Style="{StaticResource NavLabel}" /></StackPanel>
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="1" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="16,0,20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Style="{StaticResource Button.Ghost}" Width="36" MinWidth="36" Height="36" Padding="0"
                        Command="{Binding ToggleSidebarCommand}" ToolTip="折叠或展开导航" AutomationProperties.Name="折叠或展开导航">
                    <controls:LucideIcon Icon="PanelLeft" Width="18" Height="18" Stroke="{DynamicResource Brush.Text.Secondary}" />
                </Button>
                <TextBlock Grid.Column="1" Text="{Binding PageTitle}" FontSize="{StaticResource Typography.FontSize.SmallTitle}"
                           FontWeight="Medium" VerticalAlignment="Center" Margin="12,0,0,0" />
                <ComboBox Grid.Column="2" Width="112" Height="32" MinHeight="32" Margin="0,0,14,0"
                          ItemsSource="{Binding ThemeChoices}" SelectedItem="{Binding CurrentTheme, UpdateSourceTrigger=PropertyChanged}"
                          AutomationProperties.Name="主题" />
                <Button x:Name="AccountButton" Grid.Column="3" Style="{StaticResource Button.Ghost}" Height="36" MinWidth="0"
                        Padding="8,0" Margin="0,0,0,0" ContextMenu="{StaticResource AccountMenu}"
                        Click="AccountButton_Click" ToolTip="账户菜单" AutomationProperties.Name="账户菜单">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <controls:LucideIcon Icon="UserRound" Width="16" Height="16" Stroke="{DynamicResource Brush.Text.Secondary}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Account.UserName}" Foreground="{DynamicResource Brush.Text.Secondary}"
                                   Margin="8,0,6,0" VerticalAlignment="Center" MaxWidth="140" TextTrimming="CharacterEllipsis" />
                        <controls:LucideIcon Icon="ChevronRight" Width="14" Height="14" Stroke="{DynamicResource Brush.Text.Secondary}"
                                             VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                            <controls:LucideIcon.RenderTransform><RotateTransform Angle="90" /></controls:LucideIcon.RenderTransform>
                        </controls:LucideIcon>
                    </StackPanel>
                </Button>
            </Grid>
            <Border Grid.Row="1" Background="{DynamicResource Brush.Border.Subtle}" />
            <Border Grid.Row="2" Margin="16,12,20,0" Padding="12,10"
                    Background="{DynamicResource Brush.Accent.Subtle}"
                    BorderBrush="{DynamicResource Brush.Selection.Border}" BorderThickness="1"
                    CornerRadius="{StaticResource CornerRadius.Control}"
                    Visibility="{Binding IsUpdateReady, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="新版本已准备就绪" FontWeight="SemiBold" />
                        <TextBlock Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0">
                            <Run Text="版本 " /><Run Text="{Binding UpdateReadyVersion}" /><Run Text=" 已完成验证。继续前请先保存其他应用中的文件。" />
                        </TextBlock>
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource Button.Primary}" Height="32" MinWidth="90"
                            Margin="0,0,8,0" Content="立即更新" Command="{Binding InstallUpdateNowCommand}" />
                    <Button Grid.Column="2" Style="{StaticResource Button.Secondary}" Height="32" MinWidth="100"
                            Content="{Binding UpdateScheduleText}" Command="{Binding InstallAfterExitCommand}" />
                </Grid>
            </Border>
            <ContentControl Grid.Row="3" Content="{Binding CurrentContent}" />
        </Grid>
    </Grid>
</UserControl>
