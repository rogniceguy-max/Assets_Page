<UserControl x:Class="MuYingDrive.NativeWpf.Views.SyncView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MuYingDrive.NativeWpf.Controls"
             xmlns:vm="clr-namespace:MuYingDrive.NativeWpf.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:SyncViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>
    <Grid Background="{DynamicResource Brush.Surface.Canvas}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="36,28,36,36" MaxWidth="880" HorizontalAlignment="Left">

                <!-- Header: Title, Description & Text Status -->
                <Grid Margin="0,0,0,28">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="项目同步" FontSize="{StaticResource Typography.FontSize.PageTitle}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.Text.Primary}" Margin="0,0,0,6" />
                        <TextBlock Text="选择你需要剪辑的项目集数，同步至电脑中。"
                                   FontSize="{StaticResource Typography.FontSize.Body}"
                                   Foreground="{DynamicResource Brush.Text.Secondary}" />
                    </StackPanel>

                    <!-- Status Text and Actions: NO status indicator dot, purely clean status text -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding StatusText}" FontSize="{StaticResource Typography.FontSize.Body}"
                                   Foreground="{DynamicResource Brush.Text.Secondary}" VerticalAlignment="Center"
                                   Margin="0,0,16,0" />
                        <Button Style="{StaticResource Button.Primary}" Command="{Binding ToggleSyncCommand}"
                                Content="{Binding ToggleButtonLabel}" MinWidth="96" />
                        <Button Style="{StaticResource Button.Secondary}" Command="{Binding SyncNowCommand}"
                                Content="立即同步" MinWidth="88" Margin="8,0,0,0" />
                    </StackPanel>
                </Grid>

                <!-- Validation message if any error/reminder occurs -->
                <Border Background="{DynamicResource Brush.Surface.Subtle}" BorderBrush="{DynamicResource Brush.Border.Subtle}"
                        BorderThickness="1" CornerRadius="{StaticResource CornerRadius.Control}" Padding="14,10"
                        Margin="0,0,0,20">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ValidationMessage}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding ValidationMessage}" Foreground="{DynamicResource Brush.Status.Danger}"
                               FontSize="{StaticResource Typography.FontSize.Body}" />
                </Border>

                <!-- Section 1: Project Selection -->
                <Border Background="{DynamicResource Brush.Surface.Panel}" BorderBrush="{DynamicResource Brush.Border.Subtle}"
                        BorderThickness="1" CornerRadius="{StaticResource CornerRadius.Card}" Padding="24,20" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="选择项目" FontSize="{StaticResource Typography.FontSize.SmallTitle}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.Text.Primary}" Margin="0,0,0,12" />
                        <ComboBox ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject}"
                                  DisplayMemberPath="Name" MinWidth="280" MaxWidth="380" HorizontalAlignment="Left"
                                  AutomationProperties.Name="选择项目" />
                    </StackPanel>
                </Border>

                <!-- Section 2: Episode Multi-Selection -->
                <Border Background="{DynamicResource Brush.Surface.Panel}" BorderBrush="{DynamicResource Brush.Border.Subtle}"
                        BorderThickness="1" CornerRadius="{StaticResource CornerRadius.Card}" Padding="24,20" Margin="0,0,0,20">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="选择集数" FontSize="{StaticResource Typography.FontSize.SmallTitle}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Brush.Text.Primary}" Margin="0,0,0,4" />
                                <TextBlock Text="已勾选的集数将同步镜头视频与成片。" FontSize="{StaticResource Typography.FontSize.Caption}"
                                           Foreground="{DynamicResource Brush.Text.Secondary}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource Button.Ghost}" Content="全选" Command="{Binding SelectAllEpisodesCommand}"
                                        Height="28" Padding="8,0" Margin="0,0,6,0" />
                                <Button Style="{StaticResource Button.Ghost}" Content="取消全选" Command="{Binding DeselectAllEpisodesCommand}"
                                        Height="28" Padding="8,0" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="正在加载项目集数..." Foreground="{DynamicResource Brush.Text.Secondary}"
                                   Margin="0,8" Visibility="{Binding IsLoadingEpisodes, Converter={StaticResource BoolToVisibility}}" />

                        <TextBlock Text="该项目暂无可同步的集数节拍表" Foreground="{DynamicResource Brush.Text.Secondary}"
                                   Margin="0,8">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding Episodes.Count}" Value="0" />
                                                <Condition Binding="{Binding IsLoadingEpisodes}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <ItemsControl ItemsSource="{Binding Episodes}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected}" Content="{Binding Name}"
                                              FontSize="{StaticResource Typography.FontSize.Body}"
                                              Foreground="{DynamicResource Brush.Text.Primary}"
                                              Margin="0,0,24,12" VerticalContentAlignment="Center" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Section 3: Local Workspace Folder -->
                <Border Background="{DynamicResource Brush.Surface.Panel}" BorderBrush="{DynamicResource Brush.Border.Subtle}"
                        BorderThickness="1" CornerRadius="{StaticResource CornerRadius.Card}" Padding="24,20" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="剪辑电脑本地目录" FontSize="{StaticResource Typography.FontSize.SmallTitle}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.Text.Primary}" Margin="0,0,0,4" />
                        <TextBlock Text="同步后将在该目录下自动建立【集数 / 第xbeat / 视频】与【集数 / 成片】结构。"
                                   FontSize="{StaticResource Typography.FontSize.Caption}"
                                   Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,0,0,14" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding LocalDirectory, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource TextBox.Base}" VerticalContentAlignment="Center"
                                     AutomationProperties.Name="本地存储路径" />
                            <Button Grid.Column="1" Style="{StaticResource Button.Secondary}" Content="浏览..."
                                    Command="{Binding BrowseLocalDirectoryCommand}" Margin="8,0,0,0" MinWidth="80" />
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
