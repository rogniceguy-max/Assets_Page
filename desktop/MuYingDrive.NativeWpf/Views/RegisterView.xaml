<UserControl x:Class="MuYingDrive.NativeWpf.Views.RegisterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:MuYingDrive.NativeWpf.Infrastructure"
             Background="{DynamicResource Brush.Surface.Canvas}">
    <UserControl.InputBindings>
        <KeyBinding Key="Enter" Command="{Binding RegisterCommand}" />
    </UserControl.InputBindings>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="{DynamicResource Brush.Surface.Canvas}">
      <Grid MinHeight="650" Background="{DynamicResource Brush.Surface.Canvas}">
        <Border Width="420" Padding="36" HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{DynamicResource Brush.Surface.Panel}"
                BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1"
                CornerRadius="{StaticResource CornerRadius.Card}">
            <StackPanel>
                <TextBlock Text="创建账号" FontSize="{StaticResource Typography.FontSize.PageTitle}"
                           FontWeight="SemiBold" Margin="0,0,0,24" />

                <TextBlock Text="用户名" FontSize="{StaticResource Typography.FontSize.Label}" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,0,0,8" />
                <TextBox Style="{StaticResource TextBox.Base}" Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="用户名" Margin="0,0,0,16" />

                <TextBlock Text="密码" FontSize="{StaticResource Typography.FontSize.Label}" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,0,0,8" />
                <PasswordBox Style="{StaticResource PasswordBox.Base}" infra:PasswordBoxAssistant.BoundPassword="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="密码" Margin="0,0,0,16" />

                <TextBlock Text="确认密码" FontSize="{StaticResource Typography.FontSize.Label}" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,0,0,8" />
                <PasswordBox Style="{StaticResource PasswordBox.Base}" infra:PasswordBoxAssistant.BoundPassword="{Binding ConfirmPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="确认密码" Margin="0,0,0,16" />

                <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource Brush.Status.Danger}"
                           TextWrapping="Wrap" Margin="0,12,0,0" AutomationProperties.LiveSetting="Polite" />

                <Button Style="{StaticResource Button.Primary}" Content="{Binding SubmitLabel}" Command="{Binding RegisterCommand}"
                        Height="40" Margin="0,24,0,12" />

                <Button Style="{StaticResource Button.Ghost}" Content="返回登录" Command="{Binding BackToLoginCommand}"
                        HorizontalAlignment="Center" MinWidth="96" />
            </StackPanel>
        </Border>
      </Grid>
    </ScrollViewer>
</UserControl>
