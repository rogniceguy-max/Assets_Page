<UserControl x:Class="MuYingDrive.NativeWpf.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:MuYingDrive.NativeWpf.Infrastructure"
             Background="{DynamicResource Brush.Surface.Canvas}">
    <UserControl.InputBindings>
        <KeyBinding Key="Enter" Command="{Binding LoginCommand}" />
    </UserControl.InputBindings>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="{DynamicResource Brush.Surface.Canvas}">
      <Grid MinHeight="520" Background="{DynamicResource Brush.Surface.Canvas}">
        <Border Width="420" Padding="36" HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{DynamicResource Brush.Surface.Panel}"
                BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1"
                CornerRadius="{StaticResource CornerRadius.Card}">
            <StackPanel>
                <TextBlock Text="登录以访问我们的团队文件" FontSize="{StaticResource Typography.FontSize.PageTitle}"
                           FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,28" />

                <TextBlock Text="用户名" FontSize="{StaticResource Typography.FontSize.Label}" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,0,0,8" />
                <TextBox Style="{StaticResource TextBox.Base}" Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="用户名" Margin="0,0,0,20" />

                <TextBlock Text="密码" FontSize="{StaticResource Typography.FontSize.Label}" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,0,0,8" />
                <PasswordBox Style="{StaticResource PasswordBox.Base}" infra:PasswordBoxAssistant.BoundPassword="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="密码" />

                <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource Brush.Status.Danger}"
                           TextWrapping="Wrap" Margin="0,12,0,0" AutomationProperties.LiveSetting="Polite" />

                <Button Style="{StaticResource Button.Primary}" Content="{Binding SubmitLabel}" Command="{Binding LoginCommand}"
                        Height="40" Margin="0,24,0,16" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="还没有账号？" Foreground="{DynamicResource Brush.Text.Secondary}" VerticalAlignment="Center" />
                    <Button Style="{StaticResource Button.Ghost}" Height="32" MinWidth="0" Padding="6,0"
                            Content="立即注册" Foreground="{DynamicResource Brush.Accent.Primary}"
                            Command="{Binding RegisterCommand}" IsEnabled="{Binding LoginCommand.CanExecute, FallbackValue=True}" />
                </StackPanel>
            </StackPanel>
        </Border>
      </Grid>
    </ScrollViewer>
</UserControl>
