<UserControl x:Class="MuYingDrive.NativeWpf.Views.VisitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:MuYingDrive.NativeWpf.Views"
             Background="{DynamicResource Brush.Surface.Canvas}">
    <!-- The tour renders the same file browser as the employee page. It differs only in
         its data source and in reporting CanUpload/CanModify as false, so the browser
         omits every write affordance rather than showing them disabled. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="24,18,24,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="参观模式" FontSize="{StaticResource Typography.FontSize.PageTitle}"
                           FontWeight="SemiBold" VerticalAlignment="Center" />
                <Border Margin="10,0,0,0" Padding="8,2" VerticalAlignment="Center" CornerRadius="10"
                        Background="{DynamicResource Brush.Surface.Subtle}">
                    <TextBlock Text="只读" FontSize="{StaticResource Typography.FontSize.Caption}"
                               Foreground="{DynamicResource Brush.Text.Secondary}" />
                </Border>
            </StackPanel>

            <ItemsControl Grid.Column="1" ItemsSource="{Binding Spaces}" VerticalAlignment="Center"
                          HorizontalAlignment="Right" Margin="16,0,12,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource Button.Ghost}" Height="32" Margin="0,0,6,0"
                                Content="{Binding Title}"
                                Command="{Binding DataContext.SpaceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource Button.Ghost}" Height="32" MinWidth="32" Width="32" Padding="0"
                        Margin="0,0,8,0" Command="{Binding RefreshCommand}" ToolTip="刷新"
                        AutomationProperties.Name="刷新">
                    <TextBlock Text="刷新" FontSize="{StaticResource Typography.FontSize.Caption}" />
                </Button>
                <Button Style="{StaticResource Button.Ghost}" Height="32" Padding="12,0"
                        Content="退出游览" Command="{Binding ExitCommand}"
                        AutomationProperties.Name="退出游览" />
            </StackPanel>
        </Grid>

        <views:FilesView Grid.Row="1" />
    </Grid>
</UserControl>
