<UserControl x:Class="MuYingDrive.NativeWpf.Views.VisitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MuYingDrive.NativeWpf.Controls"
             Background="{DynamicResource Brush.Surface.Canvas}">
    <!-- Converters are per-view in this project (there is no global instance), and a
         missing StaticResource key only fails when the view is loaded at runtime. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>
    <!-- Read-only by construction: there is no upload, rename, move or delete control
         anywhere in this view, and the view model exposes no such command. -->
    <Grid Margin="24,18,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title row -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="参观模式" FontSize="{StaticResource Typography.FontSize.PageTitle}"
                           FontWeight="SemiBold" VerticalAlignment="Center" />
                <Border Margin="10,0,0,0" Padding="8,2" VerticalAlignment="Center" CornerRadius="10"
                        Background="{DynamicResource Brush.Surface.Subtle}">
                    <TextBlock Text="只读" FontSize="{StaticResource Typography.FontSize.Caption}"
                               Foreground="{DynamicResource Brush.Text.Secondary}" />
                </Border>
            </StackPanel>

            <!-- Space selector -->
            <ItemsControl Grid.Column="1" ItemsSource="{Binding Spaces}" VerticalAlignment="Center" Margin="0,0,12,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource Button.Ghost}" Height="32" Margin="0,0,6,0"
                                Content="{Binding Title}"
                                Command="{Binding DataContext.SpaceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button Grid.Column="2" Style="{StaticResource Button.Ghost}" Height="32" Padding="12,0"
                    Content="退出游览" Command="{Binding ExitCommand}"
                    AutomationProperties.Name="退出游览" />
        </Grid>

        <!-- Path row -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Command="{Binding NavigateUpCommand}" Width="28" MinWidth="28" Height="28" Padding="0"
                        Margin="0,0,6,0"
                        Visibility="{Binding CanNavigateUp, Converter={StaticResource BoolToVisibility}}"
                        Style="{StaticResource Button.Ghost}" ToolTip="返回上级文件夹"
                        AutomationProperties.Name="返回上级文件夹">
                    <controls:LucideIcon Icon="ChevronLeft" Width="16" Height="16"
                                         Stroke="{DynamicResource Brush.Text.Secondary}" />
                </Button>
                <TextBlock Text="{Binding CurrentPathLabel}" VerticalAlignment="Center" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"
                           FontSize="{StaticResource Typography.FontSize.SmallTitle}" />
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource Button.Ghost}" Height="28" MinWidth="28" Width="28"
                    Padding="0" Command="{Binding RefreshCommand}" ToolTip="刷新"
                    AutomationProperties.Name="刷新">
                <controls:LucideIcon Icon="RefreshCw" Width="15" Height="15"
                                     Stroke="{DynamicResource Brush.Text.Secondary}" />
            </Button>
        </Grid>

        <!-- Content -->
        <Grid Grid.Row="2">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource Brush.Status.Danger}"
                       TextWrapping="Wrap" VerticalAlignment="Top" Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />

            <TextBlock Text="这个位置没有可浏览的内容。" Foreground="{DynamicResource Brush.Text.Secondary}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />

            <ProgressBar Height="4" IsIndeterminate="True" VerticalAlignment="Top"
                         Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource Button.Ghost}" Width="196" Height="150" Margin="0,0,12,12"
                                    Padding="12" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top"
                                    Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    ToolTip="{Binding Name}"
                                    AutomationProperties.Name="{Binding Name}">
                                <StackPanel>
                                    <Grid Height="56">
                                        <controls:LucideIcon Width="40" Height="40"
                                                             HorizontalAlignment="Left" VerticalAlignment="Top"
                                                             Stroke="{DynamicResource Brush.Text.Secondary}">
                                            <controls:LucideIcon.Style>
                                                <Style TargetType="controls:LucideIcon">
                                                    <Setter Property="Icon" Value="File" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                                                            <Setter Property="Icon" Value="Folder" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </controls:LucideIcon.Style>
                                        </controls:LucideIcon>
                                    </Grid>
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"
                                               Margin="0,10,0,0" />
                                    <TextBlock Foreground="{DynamicResource Brush.Text.Secondary}"
                                               FontSize="{StaticResource Typography.FontSize.Caption}"
                                               TextTrimming="CharacterEllipsis" Margin="0,4,0,0">
                                        <Run Text="{Binding KindLabel, Mode=OneWay}" />
                                        <Run Text=" · " />
                                        <Run Text="{Binding FileSize, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <TextBlock Grid.Row="3" Margin="0,12,0,0" TextWrapping="Wrap"
                   Foreground="{DynamicResource Brush.Text.Secondary}"
                   FontSize="{StaticResource Typography.FontSize.Caption}"
                   Text="参观仅提供只读浏览与下载；个人空间不在参观范围内。" />
    </Grid>
</UserControl>
