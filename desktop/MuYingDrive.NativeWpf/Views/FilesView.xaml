<UserControl x:Class="MuYingDrive.NativeWpf.Views.FilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MuYingDrive.NativeWpf.Controls"
             Background="{DynamicResource Brush.Surface.Canvas}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="GalleryItemContainer" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}" />
            <Setter Property="ContextMenu" Value="{DynamicResource FileContextMenu}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="CardChrome" CornerRadius="{StaticResource CornerRadius.Card}" BorderThickness="1" BorderBrush="Transparent" Background="Transparent" Padding="0.5">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CardChrome" Property="BorderBrush" Value="{DynamicResource Brush.Border.Strong}" /></Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="CardChrome" Property="BorderBrush" Value="{DynamicResource Brush.Accent.Primary}" />
                                <Setter TargetName="CardChrome" Property="Background" Value="{DynamicResource Brush.Accent.Subtle}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="CardChrome" Property="BorderBrush" Value="{DynamicResource Brush.Focus.Ring}" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.6" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <EventSetter Event="PreviewMouseRightButtonDown" Handler="GalleryItem_PreviewMouseRightButtonDown" />
            <EventSetter Event="MouseDoubleClick" Handler="GalleryItem_MouseDoubleClick" />
        </Style>

        <Style x:Key="GalleryListVisible" TargetType="ListBox" BasedOn="{StaticResource ListBox.Base}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers><DataTrigger Binding="{Binding IsGridView}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="FileListVisible" TargetType="ListBox" BasedOn="{StaticResource ListBox.Base}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers><DataTrigger Binding="{Binding IsGridView}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="GridToggleButton" TargetType="Button" BasedOn="{StaticResource Button.Compact}">
            <Setter Property="MinWidth" Value="36" /><Setter Property="Width" Value="36" /><Setter Property="Height" Value="36" /><Setter Property="Padding" Value="0" />
            <Style.Triggers><DataTrigger Binding="{Binding IsGridView}" Value="True"><Setter Property="Background" Value="{DynamicResource Brush.Accent.Subtle}" /><Setter Property="BorderBrush" Value="{DynamicResource Brush.Selection.Border}" /></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="ListToggleButton" TargetType="Button" BasedOn="{StaticResource Button.Compact}">
            <Setter Property="MinWidth" Value="36" /><Setter Property="Width" Value="36" /><Setter Property="Height" Value="36" /><Setter Property="Padding" Value="0" />
            <Style.Triggers><DataTrigger Binding="{Binding IsGridView}" Value="False"><Setter Property="Background" Value="{DynamicResource Brush.Accent.Subtle}" /><Setter Property="BorderBrush" Value="{DynamicResource Brush.Selection.Border}" /></DataTrigger></Style.Triggers>
        </Style>

        <ContextMenu x:Key="FileContextMenu">
            <MenuItem Header="打开" Command="{Binding PlacementTarget.Tag.OpenCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem Header="重命名" Command="{Binding PlacementTarget.Tag.RenameCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      Visibility="{Binding PlacementTarget.Tag.CanModify, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVisibility}}" />
            <!-- Still a placeholder: moving needs a picker that browses the NAS for a
                 destination. It keeps saying so rather than quietly disappearing. -->
            <MenuItem Header="移动到" Command="{Binding PlacementTarget.Tag.UnsupportedEditCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding RelativeSource={RelativeSource Self}, Path=Header}"
                      Visibility="{Binding PlacementTarget.Tag.CanModify, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVisibility}}" />
            <!-- Duplicate applies to the whole selection, so it is handed the row that was
                 clicked and decides for itself whether that row is part of one. -->
            <MenuItem Header="复制" Command="{Binding PlacementTarget.Tag.DuplicateCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      Visibility="{Binding PlacementTarget.Tag.CanModify, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVisibility}}" />
            <Separator Visibility="{Binding PlacementTarget.Tag.CanModify, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVisibility}}" />
            <MenuItem Header="下载" Command="{Binding PlacementTarget.Tag.DownloadCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem Header="删除" Command="{Binding PlacementTarget.Tag.DeleteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      Visibility="{Binding PlacementTarget.Tag.CanModify, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVisibility}}" />
            <Separator />
            <MenuItem Header="文件信息" Command="{Binding PlacementTarget.Tag.DetailsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
        </ContextMenu>

        <DataTemplate x:Key="GalleryFileTemplate">
            <controls:RoundedClipBorder CornerRadius="{StaticResource CornerRadius.Card}"
                                         Background="{DynamicResource Brush.Surface.Subtle}"
                                         ClipToBounds="True">
                <Grid Background="{DynamicResource Brush.Surface.Subtle}">
                    <controls:AsyncThumbnail SourcePath="{Binding ThumbnailPath}" Stretch="UniformToFill"
                                             RenderOptions.BitmapScalingMode="HighQuality" />
                    <controls:LucideIcon x:Name="FilePlaceholder" Icon="File" Width="28" Height="28" Stroke="{DynamicResource Brush.Text.Secondary}"
                                         HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                    <controls:LucideIcon x:Name="FolderPlaceholder" Icon="Folder" Width="32" Height="32" Stroke="{DynamicResource Brush.Text.Secondary}"
                                         HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                    <Border x:Name="VideoBadge" Width="28" Height="28" CornerRadius="8" Margin="8" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Background="#B3101113" Visibility="Collapsed">
                        <controls:LucideIcon Icon="Video" Width="15" Height="15" Stroke="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Border x:Name="FilenameBand" MinHeight="38" VerticalAlignment="Bottom" Opacity="0"
                            Background="#D9101113" Padding="10,6">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" Foreground="#FFFFFF" FontSize="{StaticResource Typography.FontSize.Label}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                            <TextBlock Text="{Binding LogicalPath}" Foreground="#9CA3AF" FontSize="11" Margin="0,2,0,0"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding LogicalPath}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding LogicalPath}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </Grid>
            </controls:RoundedClipBorder>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsVideo}" Value="True"><Setter TargetName="VideoBadge" Property="Visibility" Value="Visible" /></DataTrigger>
                <DataTrigger Binding="{Binding ThumbnailPath}" Value=""><Setter TargetName="FilePlaceholder" Property="Visibility" Value="Visible" /><Setter TargetName="FilenameBand" Property="Opacity" Value="1" /></DataTrigger>
                <DataTrigger Binding="{Binding IsDirectory}" Value="True"><Setter TargetName="FilePlaceholder" Property="Visibility" Value="Collapsed" /><Setter TargetName="FolderPlaceholder" Property="Visibility" Value="Visible" /><Setter TargetName="FilenameBand" Property="Opacity" Value="1" /></DataTrigger>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsMouseOver}" Value="True">
                    <Setter TargetName="FilenameBand" Property="Opacity" Value="1" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="24,20,24,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="52" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Command="{Binding NavigateUpCommand}" Width="28" MinWidth="28" Height="28" Padding="0"
                        Margin="0,0,6,0" Visibility="{Binding CanNavigateUp, Converter={StaticResource BoolToVisibility}}"
                        Style="{StaticResource Button.Ghost}" ToolTip="返回上级文件夹" AutomationProperties.Name="返回上级文件夹">
                    <controls:LucideIcon Icon="ChevronLeft" Width="16" Height="16" Stroke="{DynamicResource Brush.Text.Secondary}" />
                </Button>
                <TextBlock Text="{Binding CurrentPathLabel}" FontSize="{StaticResource Typography.FontSize.SmallTitle}" FontWeight="SemiBold"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding CurrentPathLabel}" />
            </StackPanel>
            <Border Grid.Column="1" Padding="9,4" CornerRadius="{StaticResource CornerRadius.Small}"
                    Background="{DynamicResource Brush.Surface.Subtle}" BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="只读" FontSize="{StaticResource Typography.FontSize.Caption}" Foreground="{DynamicResource Brush.Text.Secondary}"
                               Visibility="{Binding IsReadOnly, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{Binding ErrorMessage}" FontSize="{StaticResource Typography.FontSize.Caption}" Foreground="{DynamicResource Brush.Status.Danger}"
                               Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
                    <!-- Not an error, but not the whole list either — and the difference
                         matters most in 图片, where a picture off the end of a long list
                         looks like a picture that is missing from the archive. -->
                    <TextBlock Text="{Binding TruncationNotice}" FontSize="{StaticResource Typography.FontSize.Caption}"
                               Foreground="{DynamicResource Brush.Text.Secondary}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TruncationNotice}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsReadOnly}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                            <DataTrigger Binding="{Binding HasError}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="180" MaxWidth="320" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <TextBox Style="{StaticResource TextBox.Search}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="搜索文件" />
                <controls:LucideIcon Icon="Search" Width="16" Height="16" Stroke="{DynamicResource Brush.Text.Secondary}"
                                      HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0" />
                <TextBlock Text="搜索文件" Margin="32,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Text.Secondary}"
                           IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers><DataTrigger Binding="{Binding SearchText}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
            <TextBlock Grid.Column="1" Text="{Binding SelectedLabel}" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}"
                       Foreground="{DynamicResource Brush.Text.Secondary}" VerticalAlignment="Center" Margin="14,0,0,0" />
            <Button Grid.Column="2" Style="{StaticResource GridToggleButton}" Command="{Binding ToggleGridCommand}" ToolTip="卡片视图" AutomationProperties.Name="卡片视图" Margin="0,0,6,0">
                <controls:LucideIcon Icon="Grid2x2" Width="16" Height="16" Stroke="{DynamicResource Brush.Text.Secondary}" />
            </Button>
            <Button Grid.Column="3" Style="{StaticResource ListToggleButton}" Command="{Binding ToggleListCommand}" ToolTip="列表视图" AutomationProperties.Name="列表视图" Margin="0,0,12,0">
                <controls:LucideIcon Icon="List" Width="16" Height="16" Stroke="{DynamicResource Brush.Text.Secondary}" />
            </Button>
            <Button Grid.Column="4" Style="{StaticResource Button.Secondary}" Command="{Binding UploadFolderCommand}" Content="上传文件夹" Margin="0,0,6,0"
                    Visibility="{Binding CanUpload, Converter={StaticResource BoolToVisibility}}" />
            <Button Grid.Column="5" Style="{StaticResource Button.Primary}" Command="{Binding UploadCommand}" Content="上传" MinWidth="84"
                    Visibility="{Binding CanUpload, Converter={StaticResource BoolToVisibility}}" />
        </Grid>

        <Grid Grid.Row="2">
            <ListBox x:Name="GalleryList" Style="{StaticResource GalleryListVisible}"
                     ItemsSource="{Binding ItemsView}" ItemTemplate="{StaticResource GalleryFileTemplate}"
                     ItemContainerStyle="{StaticResource GalleryItemContainer}" SelectionMode="Extended"
                     Background="Transparent" BorderThickness="0" Padding="0"
                     ScrollViewer.CanContentScroll="True" ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.ScrollUnit="Pixel" SelectionChanged="FileList_SelectionChanged" PreviewKeyDown="FileList_PreviewKeyDown">
                <ListBox.ItemsPanel><ItemsPanelTemplate><controls:JustifiedGalleryPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
            </ListBox>

            <ListBox x:Name="FileList" Style="{StaticResource FileListVisible}"
                     ItemsSource="{Binding ItemsView}" ItemContainerStyle="{StaticResource GalleryItemContainer}"
                     SelectionMode="Extended" Background="Transparent" BorderThickness="0" Padding="0"
                     ScrollViewer.CanContentScroll="True" ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                     SelectionChanged="FileList_SelectionChanged" PreviewKeyDown="FileList_PreviewKeyDown">
                <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel IsVirtualizing="True" VirtualizationMode="Recycling" /></ItemsPanelTemplate></ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid MinHeight="44" Margin="0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="100" /><ColumnDefinition Width="100" /><ColumnDefinition Width="128" /></Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <controls:RoundedClipBorder Width="32" Height="32" CornerRadius="{StaticResource CornerRadius.Small}"
                                                             Background="{DynamicResource Brush.Surface.Subtle}" Margin="0,0,12,0">
                                    <Grid>
                                        <controls:AsyncThumbnail SourcePath="{Binding ThumbnailPath}" Stretch="UniformToFill" />
                                        <controls:LucideIcon Icon="Folder" Width="16" Height="16" Stroke="{DynamicResource Brush.Text.Secondary}"
                                                             HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <controls:LucideIcon.Style>
                                                <Style TargetType="controls:LucideIcon">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers><DataTrigger Binding="{Binding IsDirectory}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                                </Style>
                                            </controls:LucideIcon.Style>
                                        </controls:LucideIcon>
                                        <controls:LucideIcon Icon="File" Width="16" Height="16" Stroke="{DynamicResource Brush.Text.Secondary}"
                                                             HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <controls:LucideIcon.Style>
                                                <Style TargetType="controls:LucideIcon">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ThumbnailPath}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                                        <DataTrigger Binding="{Binding IsDirectory}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </controls:LucideIcon.Style>
                                        </controls:LucideIcon>
                                    </Grid>
                                </controls:RoundedClipBorder>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding LogicalPath}" FontSize="11" Foreground="{DynamicResource Brush.Text.Secondary}"
                                               Margin="0,2,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding LogicalPath}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding LogicalPath}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding KindLabel}" Foreground="{DynamicResource Brush.Text.Secondary}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding FileSize}" Foreground="{DynamicResource Brush.Text.Secondary}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3" Text="{Binding ModifiedLabel}" Foreground="{DynamicResource Brush.Text.Secondary}" VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Border Background="{DynamicResource Brush.Surface.Canvas}" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding LoadingMessage}" Foreground="{DynamicResource Brush.Text.Secondary}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
        </Grid>
        <Border Grid.Row="0" Grid.RowSpan="3" Background="Transparent" IsHitTestVisible="False"
                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding EmptyMessage}" Foreground="{DynamicResource Brush.Text.Secondary}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Margin="0,0,8,8" />
        </Border>
    </Grid>
</UserControl>
