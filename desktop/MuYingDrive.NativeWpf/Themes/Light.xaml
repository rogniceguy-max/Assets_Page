<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Radix Slate / Iris light palette mapped to replaceable semantic brushes. -->
    <SolidColorBrush x:Key="Brush.Surface.Canvas" Color="#FCFCFD" />
    <SolidColorBrush x:Key="Brush.Surface.Panel" Color="#F9F9FB" />
    <SolidColorBrush x:Key="Brush.Surface.Subtle" Color="#F0F0F3" />
    <SolidColorBrush x:Key="Brush.Border.Subtle" Color="#E8E8EC" />
    <SolidColorBrush x:Key="Brush.Border.Strong" Color="#D9D9E0" />
    <SolidColorBrush x:Key="Brush.Scrollbar.Thumb" Color="#C8CBD2" />
    <SolidColorBrush x:Key="Brush.Scrollbar.ThumbHover" Color="#979BA4" />
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="#60646C" />
    <SolidColorBrush x:Key="Brush.Text.Primary" Color="#1C2024" />
    <SolidColorBrush x:Key="Brush.Text.OnAccent" Color="#FCFCFD" />

    <SolidColorBrush x:Key="Brush.Accent.Subtle" Color="#F0F0FF" />
    <SolidColorBrush x:Key="Brush.Accent.Primary" Color="#5B5BD6" />
    <SolidColorBrush x:Key="Brush.Accent.Hover" Color="#5151CD" />
    <SolidColorBrush x:Key="Brush.Accent.Pressed" Color="#5753C6" />
    <SolidColorBrush x:Key="Brush.Focus.Ring" Color="#5B5BD6" />

    <SolidColorBrush x:Key="Brush.Control.Background" Color="#FCFCFD" />
    <SolidColorBrush x:Key="Brush.Control.Border" Color="#D9D9E0" />
    <SolidColorBrush x:Key="Brush.Control.HoverBackground" Color="#F0F0F3" />
    <SolidColorBrush x:Key="Brush.Control.DisabledBackground" Color="#F0F0F3" />
    <SolidColorBrush x:Key="Brush.Control.DisabledForeground" Color="#60646C" />

    <SolidColorBrush x:Key="Brush.Selection.Background" Color="#F0F0FF" />
    <SolidColorBrush x:Key="Brush.Selection.Border" Color="#5B5BD6" />
    <SolidColorBrush x:Key="Brush.Selection.Foreground" Color="#1C2024" />
    <SolidColorBrush x:Key="Brush.Status.Danger" Color="#D14343" />
</ResourceDictionary>
