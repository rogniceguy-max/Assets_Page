<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Radix Slate / Iris dark palette mapped to the same semantic brush keys. -->
    <SolidColorBrush x:Key="Brush.Surface.Canvas" Color="#111113" />
    <SolidColorBrush x:Key="Brush.Surface.Panel" Color="#18191B" />
    <SolidColorBrush x:Key="Brush.Surface.Subtle" Color="#212225" />
    <SolidColorBrush x:Key="Brush.Border.Subtle" Color="#272A2D" />
    <SolidColorBrush x:Key="Brush.Border.Strong" Color="#363A3F" />
    <SolidColorBrush x:Key="Brush.Scrollbar.Thumb" Color="#45484E" />
    <SolidColorBrush x:Key="Brush.Scrollbar.ThumbHover" Color="#686C74" />
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="#AFB3BA" />
    <SolidColorBrush x:Key="Brush.Text.Primary" Color="#EDEEF0" />
    <SolidColorBrush x:Key="Brush.Text.OnAccent" Color="#EDEEF0" />

    <SolidColorBrush x:Key="Brush.Accent.Subtle" Color="#252963" />
    <SolidColorBrush x:Key="Brush.Accent.Primary" Color="#5B5BD6" />
    <SolidColorBrush x:Key="Brush.Accent.Hover" Color="#6E6ADE" />
    <SolidColorBrush x:Key="Brush.Accent.Pressed" Color="#6E6ADE" />
    <SolidColorBrush x:Key="Brush.Focus.Ring" Color="#B1A9FF" />

    <SolidColorBrush x:Key="Brush.Control.Background" Color="#18191B" />
    <SolidColorBrush x:Key="Brush.Control.Border" Color="#363A3F" />
    <SolidColorBrush x:Key="Brush.Control.HoverBackground" Color="#212225" />
    <SolidColorBrush x:Key="Brush.Control.DisabledBackground" Color="#212225" />
    <SolidColorBrush x:Key="Brush.Control.DisabledForeground" Color="#AFB3BA" />

    <SolidColorBrush x:Key="Brush.Selection.Background" Color="#252963" />
    <SolidColorBrush x:Key="Brush.Selection.Border" Color="#B1A9FF" />
    <SolidColorBrush x:Key="Brush.Selection.Foreground" Color="#EDEEF0" />
    <SolidColorBrush x:Key="Brush.Status.Danger" Color="#FF7B72" />
</ResourceDictionary>
