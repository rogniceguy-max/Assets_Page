<Window x:Class="MuYingDrive.Updater.Views.UpdaterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="沐影盘更新程序" Width="460" MinWidth="400" MaxWidth="520" Height="304" MinHeight="280"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" ShowInTaskbar="True"
        Background="{DynamicResource Brush.Surface.Canvas}" UseLayoutRounding="True" SnapsToDevicePixels="True"
        Closing="Window_Closing" AutomationProperties.Name="沐影盘更新程序">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="1" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{DynamicResource Brush.Border.Subtle}" />
        <Grid Grid.Row="1" Margin="24,22,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /><RowDefinition Height="10" /><RowDefinition Height="Auto" />
                <RowDefinition Height="20" /><RowDefinition Height="Auto" /><RowDefinition Height="10" />
                <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
            <TextBlock Grid.Row="2" Text="{Binding Explanation}" Foreground="{DynamicResource Brush.Text.Secondary}" TextWrapping="Wrap" />
            <!-- ProgressBar.Value binds TwoWay by default; Progress is read-only, so the
                 default mode throws InvalidOperationException while the window is being
                 constructed and the updater dies before it can show anything. -->
            <ProgressBar Grid.Row="4" Height="4" Minimum="0" Maximum="100" Value="{Binding Progress, Mode=OneWay}"
                         IsIndeterminate="{Binding IsProgressIndeterminate}" AutomationProperties.Name="更新进度">
                <ProgressBar.Style>
                    <Style TargetType="ProgressBar">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ProgressBar.Style>
            </ProgressBar>
            <DockPanel Grid.Row="6">
                <TextBlock Text="{Binding Status}" Foreground="{DynamicResource Brush.Text.Secondary}" VerticalAlignment="Center" />
                <TextBlock DockPanel.Dock="Right" Foreground="{DynamicResource Brush.Text.Secondary}" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsBusy}" Value="True" />
                                    <Condition Binding="{Binding IsProgressIndeterminate}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                    <Run Text="{Binding Progress, StringFormat={}{0:F0}%}" />
                </TextBlock>
            </DockPanel>
            <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消更新" Margin="0,0,8,0" Command="{Binding CancelCommand}">
                    <Button.Style><Style TargetType="Button" BasedOn="{StaticResource ActionButton}"><Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding IsBusy}" Value="True" />
                            <Condition Binding="{Binding CanCancel}" Value="True" />
                        </MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible" /></MultiDataTrigger></Style.Triggers>
                    </Style></Button.Style>
                </Button>
                <Button Content="{Binding LaunchActionText}" Margin="0,0,8,0" Command="{Binding LaunchCommand}">
                    <Button.Style><Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}"><Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers><DataTrigger Binding="{Binding HasLaunchPath}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                    </Style></Button.Style>
                </Button>
                <Button Content="{Binding ActionText}" Command="{Binding CloseCommand}">
                    <Button.Style><Style TargetType="Button" BasedOn="{StaticResource ActionButton}"><Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers><DataTrigger Binding="{Binding IsBusy}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                    </Style></Button.Style>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
